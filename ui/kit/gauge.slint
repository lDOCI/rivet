// Temperature arc: 270°, current value inside, target marker as colour.
import { Tokens } from "tokens.slint";

export component Gauge inherits Rectangle {
    in property <float> current;
    in property <float> target;
    in property <float> maximum: 350;
    in property <length> size: 44px;
    in property <length> value-size: 12px;
    in property <int> value-weight: 800;
    width: root.size;
    height: root.size;
    property <float> fraction: max(0.001, min(1, root.current / root.maximum));
    property <angle> end: 135deg + self.fraction * 270deg;
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 120;
        viewbox-height: 120;
        stroke: #232831;
        stroke-width: root.size * 0.1;
        stroke-line-cap: round;
        // 270° arc from the bottom left, clockwise. The prototype's band runs from
        // radius 45 to 55 (r 50, width 10, centred); this renderer strokes inside
        // the line, so the line is the band's outer edge, 55.
        commands: "M21.11 98.89 A55 55 0 1 1 98.89 98.89";
    }
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 120;
        viewbox-height: 120;
        stroke: root.target > 0 ? Tokens.heat-2 : Tokens.line;
        stroke-width: root.size * 0.1;
        stroke-line-cap: round;
        // Path elements, not a command string: a string would format the
        // numbers with the language's decimal comma and break the arc.
        MoveTo { x: 21.11; y: 98.89; }
        ArcTo {
            radius-x: 55;
            radius-y: 55;
            x: 60 + 55 * cos(root.end);
            y: 60 + 55 * sin(root.end);
            large-arc: root.fraction > 0.6667;
            sweep: true;
        }
    }
    Text {
        text: round(root.current) + "°";
        color: Tokens.text;
        font-size: root.value-size;
        font-weight: root.value-weight;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
