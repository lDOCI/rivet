// Model preview from the G-code file, or the printer icon while there is none.
import { Tokens } from "tokens.slint";
import { Icons } from "icons.slint";
import { Icon } from "controls.slint";

export component Thumb inherits Rectangle {
    in property <image> source;
    in property <bool> has;
    in property <length> icon-size: 56px;
    background: #1a1f27;
    clip: true;
    if root.has: Image {
        width: parent.width;
        height: parent.height;
        source: root.source;
        image-fit: contain;
    }
    if !root.has: Icon { d: Icons.printer; size: root.icon-size; weight: 1.3; color: Tokens.text-faint; }
}
