// Value controls. docs/ux/design-code.md §4:
//   range value          → VBar (drag + ± under it)
//   tuned during a print → FineStepper (two step sizes each side)
//   exact number         → Stepper (tap the value for the keypad)
import { Tokens } from "tokens.slint";
import { SecondaryButton } from "controls.slint";
import { BarFill, HBarFill } from "fills.slint";

// Vertical bar: label, value above, drag up/down, − / + below.
export component VBar inherits VerticalLayout {
    in property <string> label;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 5;
    in property <float> big-step: 10;
    in property <string> unit: "%";
    in property <bool> off-at-zero;
    in-out property <float> value;
    // Live value from the printer (>= 0). The bar follows it, except while a
    // finger is on the bar; then it follows the finger. Without it, `value`
    // is the bar's own state.
    in property <float> source: -1;
    // Fired on release: commands go out once, not on every drag tick.
    callback committed(float);
    width: 108px;
    spacing: 6px;

    property <float> local;
    property <float> shown: root.source >= 0 ? (drag.pressed ? root.local : root.source) : root.value;

    function clamp-step(v: float) -> float {
        return max(root.minimum, min(root.maximum, round(v / root.step) * root.step));
    }
    function from-y(y: length) -> float {
        return root.clamp-step(root.minimum + (1 - y / track.height) * (root.maximum - root.minimum));
    }
    function set-value(v: float) {
        if (root.source >= 0) { root.local = v; } else { root.value = v; }
    }
    // ± button: one new value, shown at once and sent once.
    function nudge-to(v: float) {
        root.set-value(v);
        root.committed(v);
    }

    Text {
        text: root.label;
        color: Tokens.text-dim;
        font-size: Tokens.caption;
        font-weight: 600;
        horizontal-alignment: center;
        overflow: elide;
    }
    Text {
        text: root.off-at-zero && root.shown == 0 ? @tr("Off") : round(root.shown) + root.unit;
        color: Tokens.text;
        font-size: 24px;
        font-weight: 800;
        horizontal-alignment: center;
    }
    track := Rectangle {
        vertical-stretch: 1;
        min-height: 120px;
        border-radius: Tokens.r-l;
        background: Tokens.surface-1;
        accessible-role: slider;
        accessible-label: root.label;
        accessible-value: round(root.shown);
        accessible-value-minimum: root.minimum;
        accessible-value-maximum: root.maximum;
        BarFill {
            width: parent.width;
            height: parent.height;
            radius: Tokens.r-l;
            fraction: (root.shown - root.minimum) / (root.maximum - root.minimum);
        }
        drag := TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root.local = root.from-y(self.mouse-y);
                }
                if (e.kind == PointerEventKind.up) {
                    // By now the finger is up, so `shown` is the printer's old value again:
                    // send what the finger set.
                    root.committed(root.source >= 0 ? root.local : root.value);
                }
            }
            moved => {
                if (self.pressed) {
                    root.set-value(root.from-y(self.mouse-y));
                }
            }
            clicked => {
                root.set-value(root.from-y(self.mouse-y));
            }
        }
    }
    HorizontalLayout {
        spacing: 6px;
        SecondaryButton {
            text: "−";
            font-size: 26px;
            min-width: 0px;
            min-height: 56px;
            clicked => { root.nudge-to(root.clamp-step(root.shown - root.big-step)); }
        }
        SecondaryButton {
            text: "+";
            font-size: 26px;
            min-width: 0px;
            min-height: 56px;
            clicked => { root.nudge-to(root.clamp-step(root.shown + root.big-step)); }
        }
    }
}

// − value + in a card. Tapping the value asks for the keypad.
export component Stepper inherits Rectangle {
    in property <string> title;
    in property <string> sub;
    in property <string> label; // formatted value with unit
    callback decrement;
    callback increment;
    callback edit;
    min-height: 84px;
    border-radius: Tokens.r-m;
    background: Tokens.surface-1;
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: root.title; color: Tokens.text; font-size: Tokens.row-title; font-weight: 700; overflow: elide; }
            if root.sub != "": Text { text: root.sub; color: Tokens.text-dim; font-size: Tokens.caption; overflow: elide; }
        }
        SecondaryButton { width: 64px; height: 64px; y: (parent.height - 64px) / 2; text: "−"; font-size: 30px; clicked => { root.decrement(); } }
        Rectangle {
            width: 120px;
            Text { text: root.label; color: Tokens.text; font-size: 22px; font-weight: 800; }
            TouchArea { clicked => { root.edit(); } }
        }
        SecondaryButton { width: 64px; height: 64px; y: (parent.height - 64px) / 2; text: "+"; font-size: 30px; clicked => { root.increment(); } }
    }
}

// Two step sizes each side, for values tuned during a print (speed, flow, Z).
// A changed value turns accent and the caption says what it was.
export component FineStepper inherits Rectangle {
    in property <string> title;
    in property <string> sub;
    in property <string> label;      // formatted current value
    in property <bool> changed;
    in property <string> was;        // formatted original value
    in property <string> big;        // e.g. "10"
    in property <string> small;      // e.g. "1"
    callback step(float);            // +/- big or small, in value units
    callback edit;
    in property <float> big-step;
    in property <float> small-step;
    min-height: 92px;
    border-radius: Tokens.r-m;
    background: Tokens.surface-1;
    border-width: root.changed ? 2px : 0;
    border-color: #2dd4bf66;
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: root.title; color: Tokens.text; font-size: Tokens.row-title; font-weight: 700; overflow: elide; }
            Text {
                text: root.changed ? @tr("was {}", root.was) : root.sub;
                color: Tokens.text-dim;
                font-size: Tokens.caption;
                overflow: elide;
            }
        }
        SecondaryButton { width: 64px; height: 64px; y: (parent.height - 64px) / 2; text: "−" + root.big; font-size: 16px; clicked => { root.step(-root.big-step); } }
        SecondaryButton { width: 64px; height: 64px; y: (parent.height - 64px) / 2; text: "−" + root.small; font-size: 16px; clicked => { root.step(-root.small-step); } }
        Rectangle {
            width: 104px;
            Text { text: root.label; color: root.changed ? Tokens.accent-hi : Tokens.text; font-size: 26px; font-weight: 800; }
            TouchArea { clicked => { root.edit(); } }
        }
        SecondaryButton { width: 64px; height: 64px; y: (parent.height - 64px) / 2; text: "+" + root.small; font-size: 16px; clicked => { root.step(root.small-step); } }
        SecondaryButton { width: 64px; height: 64px; y: (parent.height - 64px) / 2; text: "+" + root.big; font-size: 16px; clicked => { root.step(root.big-step); } }
    }
}

// Horizontal bar in a row: title and caption, a wide bar, the value. Same
// rule as VBar: it follows the printer, except while a finger is on it.
export component SliderRow inherits Rectangle {
    in property <string> title;
    in property <string> sub;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 5;
    in property <string> unit: "%";
    in property <bool> off-at-zero;
    in property <float> source;
    callback committed(float);
    min-height: 84px;
    border-radius: Tokens.r-m;
    background: Tokens.surface-1;

    property <float> local;
    property <float> shown: drag.pressed ? root.local : root.source;
    function from-x(x: length) -> float {
        return max(root.minimum, min(root.maximum, round((root.minimum + x / bar.width * (root.maximum - root.minimum)) / root.step) * root.step));
    }

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 12px;
        spacing: 16px;
        VerticalLayout {
            width: 170px;
            alignment: center;
            spacing: 2px;
            Text { text: root.title; color: Tokens.text; font-size: Tokens.row-title; font-weight: 700; overflow: elide; }
            if root.sub != "": Text { text: root.sub; color: Tokens.text-dim; font-size: Tokens.caption; overflow: elide; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            bar := Rectangle {
                height: 60px;
                border-radius: 18px;
                background: Tokens.surface-2;
                accessible-role: slider;
                accessible-label: root.title;
                accessible-value: round(root.shown);
                accessible-value-minimum: root.minimum;
                accessible-value-maximum: root.maximum;
                HBarFill {
                    width: parent.width;
                    height: parent.height;
                    radius: 18px;
                    fraction: (root.shown - root.minimum) / (root.maximum - root.minimum);
                }
                drag := TouchArea {
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) { root.local = root.from-x(self.mouse-x); }
                        if (e.kind == PointerEventKind.up) { root.committed(root.local); }
                    }
                    moved => { if (self.pressed) { root.local = root.from-x(self.mouse-x); } }
                }
            }
        }
        Text {
            width: 86px;
            text: root.off-at-zero && root.shown == 0 ? @tr("Off") : round(root.shown) + root.unit;
            color: Tokens.text;
            font-size: 20px;
            font-weight: 800;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}
