// Temperature dial: 270° arc, the current value filled, a knob at the target
// that can be dragged. design-code §4: a dial is for temperatures only.
import { Tokens } from "tokens.slint";

export component HeatDial inherits Rectangle {
    in property <float> current;
    in property <float> target;
    in property <float> maximum: 350;
    in property <float> step: 5;
    // Fired on release, once: the command goes out when the finger lifts.
    callback committed(float);
    // The prototype draws a 300-unit circle at 320 px; every length here
    // follows the real size, so the target dot always sits on the arc.
    width: 320px;
    height: 320px;
    accessible-role: slider;
    accessible-label: @tr("Target temperature");
    accessible-value: round(root.shown);
    accessible-value-minimum: 0;
    accessible-value-maximum: root.maximum;

    property <float> s: root.width / 300px;
    property <bool> dragging;
    property <float> drag-value;
    property <float> shown: root.dragging ? root.drag-value : root.target;
    property <float> current-fraction: max(0.001, min(1, root.current / root.maximum));
    property <float> target-fraction: max(0, min(1, root.shown / root.maximum));
    property <angle> current-end: 135deg + root.current-fraction * 270deg;
    property <angle> target-angle: 135deg + root.target-fraction * 270deg;

    // Value under the finger; the dead zone at the bottom is ignored.
    function value-at(x: length, y: length) -> float {
        // 0 at the start of the arc (bottom left), 270 at its end.
        // (a + 225) mod 360 == (a - 135) mod 360
        return root.clamp(mod(atan2((y - root.height / 2) / 1px, (x - root.width / 2) / 1px) / 1deg + 225, 360));
    }
    function clamp(a: float) -> float {
        return a > 270 ? -1 : max(0, min(root.maximum, round(a / 270 * root.maximum / root.step) * root.step));
    }

    // All coordinates are in real pixels (the prototype's 300-unit circle times
    // `s`), so the arc, the dot and the text can never drift apart.
    // This renderer draws a path's stroke on the inside of the line, an SVG
    // draws it centred. The band's middle is at radius 120 (where the dot
    // sits), so the line itself runs at the band's outer edge, 130.
    // Track: the whole 270° arc.
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        stroke: #171b21;
        stroke-width: 20px * root.s;
        stroke-line-cap: round;
        MoveTo { x: (150 + 130 * cos(135deg)) * root.s; y: (150 + 130 * sin(135deg)) * root.s; }
        ArcTo {
            radius-x: 130 * root.s;
            radius-y: 130 * root.s;
            x: (150 + 130 * cos(45deg)) * root.s;
            y: (150 + 130 * sin(45deg)) * root.s;
            large-arc: true;
            sweep: true;
        }
    }
    // Current temperature: yellow to orange, bottom left to top right. The
    // renderer has no gradient on strokes, so the arc is drawn as short
    // pieces whose colour follows the prototype's gradient direction.
    for i in 30: Path {
        property <angle> from: 135deg + i * 9deg;
        property <angle> to: min(root.current-end, self.from + 9.6deg);
        property <float> t: (2 + cos(self.from + 4.5deg) - sin(self.from + 4.5deg)) / 4;
        width: parent.width;
        height: parent.height;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        visible: root.current-end > self.from;
        stroke: Tokens.heat-1.mix(Tokens.heat-2, self.t);
        stroke-width: 20px * root.s;
        stroke-line-cap: round;
        MoveTo { x: (150 + 130 * cos(parent.from)) * root.s; y: (150 + 130 * sin(parent.from)) * root.s; }
        ArcTo {
            radius-x: 130 * root.s;
            radius-y: 130 * root.s;
            x: (150 + 130 * cos(parent.to)) * root.s;
            y: (150 + 130 * sin(parent.to)) * root.s;
            sweep: true;
        }
    }
    // Target dot, on the arc: faint halo while dragging, dark ring, white core.
    property <length> kx: (150 + 120 * cos(root.target-angle)) * root.s * 1px;
    property <length> ky: (150 + 120 * sin(root.target-angle)) * root.s * 1px;
    Rectangle {
        x: root.kx - self.width / 2;
        y: root.ky - self.height / 2;
        width: 44px * root.s;
        height: self.width;
        border-radius: self.width / 2;
        background: #f4f6f8;
        opacity: root.dragging ? 0.18 : 0;
    }
    Rectangle {
        x: root.kx - self.width / 2;
        y: root.ky - self.height / 2;
        width: 30px * root.s;
        height: self.width;
        border-radius: self.width / 2;
        background: #0b0d10;
    }
    Rectangle {
        x: root.kx - self.width / 2;
        y: root.ky - self.height / 2;
        width: 20px * root.s;
        height: self.width;
        border-radius: self.width / 2;
        background: #f4f6f8;
    }
    @children
    TouchArea {
        pointer-event(e) => {
            if (e.button != PointerEventButton.left) { return; }
            if (e.kind == PointerEventKind.down) {
                if (root.value-at(self.mouse-x, self.mouse-y) >= 0) {
                    root.drag-value = root.value-at(self.mouse-x, self.mouse-y);
                    root.dragging = true;
                }
            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                if (root.dragging) {
                    root.dragging = false;
                    root.committed(root.drag-value);
                }
            }
        }
        moved => {
            if (root.dragging && root.value-at(self.mouse-x, self.mouse-y) >= 0) {
                root.drag-value = root.value-at(self.mouse-x, self.mouse-y);
            }
        }
    }
}
