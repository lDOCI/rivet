// Basic building blocks: icon, header, buttons. docs/design/design-code.md §4.
import { Tokens } from "tokens.slint";
import { Icons } from "icons.slint";

// 24x24 stroke icon from Icons.
export component Icon inherits Path {
    in property <string> d;
    in property <color> color: Tokens.text;
    in property <length> size: 26px;
    in property <float> weight: 1.9;
    width: root.size;
    height: root.size;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.d;
    stroke: root.color;
    stroke-width: root.weight * root.size / 24;
    stroke-line-cap: round;
    // Solid shapes (play, pause, stop) fill with the same colour.
    in property <bool> filled;
    fill: root.filled ? root.color : transparent;
}

export component BackButton inherits Rectangle {
    callback clicked;
    width: Tokens.touch;
    height: Tokens.touch;
    border-radius: Tokens.r-m;
    background: ta.pressed ? Tokens.surface-2 : Tokens.surface-1;
    accessible-role: button;
    accessible-label: @tr("Back");
    Icon {
        d: "m15 18-6-6 6-6";
        weight: 2.2;
    }
    // Fingers on this panel land right of and below the point aimed at (a
    // recording of real taps on Back: x 151–183 for a button at 104–168), so
    // the button takes taps well beyond what it draws, as phones do.
    ta := TouchArea {
        x: -16px;
        y: -16px;
        width: parent.width + 72px;
        height: parent.height + 32px;
        clicked => { root.clicked(); }
    }
}

// One header row: back · title · at most one action (as children).
export component Header inherits HorizontalLayout {
    in property <string> title;
    in property <bool> back: true;
    callback back-clicked;
    height: Tokens.header;
    spacing: 14px;
    if root.back: BackButton {
        clicked => { root.back-clicked(); }
    }
    // No title: whatever the screen puts in the header takes the room.
    if root.title != "": Text {
        text: root.title;
        color: Tokens.text;
        font-size: Tokens.title;
        font-weight: 800;
        letter-spacing: -0.52px; // -0.02em, as the prototype's h1
        vertical-alignment: center;
        horizontal-stretch: 1;
        overflow: elide;
        accessible-role: text;
    }
    @children
}

// The one filled button per screen.
export component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <string> sub;
    in property <bool> enabled: true;
    callback clicked;
    min-height: Tokens.touch-primary;
    border-radius: Tokens.r-m;
    background: !root.enabled ? Tokens.surface-2 : ta.pressed ? Tokens.accent.darker(15%) : Tokens.accent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        Text {
            text: root.text;
            color: root.enabled ? Tokens.accent-ink : Tokens.text-faint;
            font-size: Tokens.row-title;
            font-weight: 800;
            horizontal-alignment: center;
        }
        if root.sub != "": Text {
            text: root.sub;
            color: root.enabled ? Tokens.accent-ink : Tokens.text-faint;
            opacity: 0.75;
            font-size: 13px;
            horizontal-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Plain secondary button (surface fill), e.g. ± or a choice in a pair.
export component SecondaryButton inherits Rectangle {
    in property <string> text;
    in property <length> radius: Tokens.r-s;
    in property <length> font-size: 17px;
    in property <color> fg: Tokens.text;
    in property <bool> enabled: true;
    callback clicked;
    min-height: Tokens.touch;
    min-width: Tokens.touch;
    border-radius: root.radius;
    background: ta.pressed ? Tokens.surface-3 : Tokens.surface-2;
    opacity: root.enabled ? 1 : 0.4;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    Text {
        text: root.text;
        color: root.fg;
        font-size: root.font-size;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component SectionLabel inherits Text {
    color: Tokens.text-faint;
    font-size: Tokens.section;
    font-weight: 700;
    letter-spacing: 0.5px;
}

// Solid red: only inside a confirm dialog (design-code §4, Destructive).
export component DangerButton inherits Rectangle {
    in property <string> text;
    callback clicked;
    min-height: Tokens.touch-primary;
    border-radius: Tokens.r-m;
    background: ta.pressed ? Tokens.danger-solid.darker(15%) : Tokens.danger-solid;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    Text {
        text: root.text;
        color: #ffffff;
        font-size: Tokens.row-title;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Icon over a label, 84 px tall: the actions row of the print screen.
export component ActionTile inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> filled;
    in property <bool> danger;
    callback clicked;
    min-height: 84px;
    border-radius: Tokens.r-m;
    background: root.danger ? (ta.pressed ? #fb4b5e40 : Tokens.danger-soft) : (ta.pressed ? Tokens.surface-3 : Tokens.surface-2);
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    // Icon and label centred together, 6 px apart; the label may run wider than a
    // narrow tile (81 px, «Подстройка»), as it does in the prototype.
    property <length> label-h: 19px;
    property <length> top: (root.height - 26px - 6px - root.label-h) / 2;
    Icon {
        x: (root.width - 26px) / 2;
        y: root.top;
        d: root.icon;
        size: 26px;
        filled: root.filled;
        color: root.danger ? Tokens.danger : Tokens.text;
    }
    Text {
        x: -12px;
        y: root.top + 32px;
        width: root.width + 24px;
        height: root.label-h;
        text: root.text;
        color: root.danger ? Tokens.danger : Tokens.text;
        font-size: 15px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Square icon button in a header (select, filter, more).
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> filled;
    callback clicked;
    width: Tokens.touch;
    height: Tokens.touch;
    border-radius: Tokens.r-m;
    background: ta.pressed ? Tokens.surface-2 : Tokens.surface-1;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Icon { d: root.icon; size: 24px; filled: root.filled; }
    ta := TouchArea { clicked => { root.clicked(); } }
}
