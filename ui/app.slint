import { Tokens } from "kit/tokens.slint";
import { Rail } from "kit/rail.slint";
import { ControlScreen } from "screens/control.slint";
import { FansScreen, FanRow, ZOffsetScreen } from "screens/tune.slint";
import { LightForm, SpeedForm, TuneForm, MoreForm, ExtruderForm, SettingsForm, FileActionsForm, JobQueueForm, MotionMoreForm, LayerPauseForm, RetractionForm, DryerForm, SpoolsForm, DevicesForm } from "generated/forms.slint";
import { FormRow } from "kit/form.slint";

export { FormRow }

// Words the engine puts into rows it builds (spools): translated here, read from Rust.
export global Strings {
    out property <string> active: @tr("active");
    // "{}" stays in for the engine to fill.
    out property <string> grams: @tr("{} g", "{}");
}
import { Format } from "kit/format.slint";
// Rust formats durations for rows it builds (the queue) the same way.
export { Format }
import { Dialog, Keypad, StopDialog } from "kit/dialogs.slint";
import { StatusScreen } from "screens/status.slint";
import { Toast } from "kit/toast.slint";
import { HomeScreen } from "screens/home.slint";
import { HeatingScreen } from "screens/heating.slint";
import { MotionScreen } from "screens/motion.slint";
import { ToolsScreen, ConsoleScreen, MacrosScreen, ConsoleLine } from "screens/tools.slint";
import { FilesScreen, FileScreen, FileItem, FileInfo, FindScreen, RenameScreen, MoveScreen } from "screens/files.slint";
export { FileItem, FileInfo, ConsoleLine, FanRow }
import { PrintingScreen, PrintDoneScreen, AmbientScreen, RunoutScreen } from "screens/print.slint";

// Embedded into the binary (see build.rs): the printer has no system fonts.
import "../assets/fonts/Inter-Regular.ttf";
import "../assets/fonts/Inter-Medium.ttf";
import "../assets/fonts/Inter-SemiBold.ttf";
import "../assets/fonts/Inter-Bold.ttf";
// 800: titles and big numbers in the prototype.
import "../assets/fonts/Inter-ExtraBold.ttf";

export component AppWindow inherits Window {
    width: 800px;
    height: 480px;
    default-font-family: "Inter";
    title: "Rivet";
    background: Tokens.bg;
    default-font-size: 16px;

    // "ready" | "startup" | "error" | "klippy-offline" | "offline"
    in property <string> link-state: "offline";
    in property <string> klippy-message;
    in property <float> extruder-temp;
    in property <float> extruder-target;
    in property <float> bed-temp;
    in property <float> bed-target;
    // standby | printing | paused | complete | cancelled | error
    in property <string> print-state;
    in property <string> filename;
    in property <float> progress;
    // -1 where the value is unknown (no estimate yet, slicer sent no layers).
    in property <int> remaining-minutes: -1;
    in property <int> elapsed-minutes;
    in property <int> layer: -1;
    in property <int> total-layers: -1;
    // Newest job in history; empty name when there is none.
    in property <string> last-name;
    in property <int> last-minutes;
    in property <int> last-days-ago: -1;
    in property <bool> last-completed: true;
    in property <image> last-thumb;
    in property <bool> has-last-thumb;
    // Preview of the file being printed.
    in property <image> print-thumb;
    in property <bool> has-print-thumb;
    // "Done" screen was acknowledged; a new print resets it.
    property <bool> done-dismissed;
    changed print-state => {
        if (self.print-state != "complete") { self.done-dismissed = false; }
        if (self.print-state != "paused") { self.runout = false; } else if (self.filament-out) { self.runout = true; }
    }

    callback home-all();
    callback pause-print();
    callback resume-print();
    callback cancel-print();
    callback emergency-stop();
    callback start-print(string);
    callback set-speed(float);
    callback set-flow(float);
    callback adjust-z(float);
    callback set-pressure-advance(float);
    callback set-light-level(float);
    callback run-gcode(string);
    callback clear-console();
    callback apply-key(string, string) -> string;
    in property <[ConsoleLine]> console-lines;
    in property <[string]> macros;
    in-out property <string> console-text;
    in-out property <bool> console-keyboard;
    in-out property <string> macro-pending;
    callback move-axis(int, float);
    callback motors-off();
    callback extrude(float, float);
    // Toolhead: position and which axes Klipper has a position for.
    in property <float> position-x;
    in property <float> position-y;
    in property <float> position-z;
    in property <bool> homed-x;
    in property <bool> homed-y;
    in property <bool> homed-z;
    // Axis travel from the printer's config, mm.
    in property <float> axis-min-x;
    in property <float> axis-min-y;
    in property <float> axis-min-z;
    in property <float> axis-max-x;
    in property <float> axis-max-y;
    in property <float> axis-max-z;
    // Motion · more: where to go, jog speeds (mm/s), screen-only axis inversion.
    in-out property <float> goto-x;
    in-out property <float> goto-y;
    in-out property <float> goto-z: 10;
    in-out property <float> jog-xy-speed: 100;
    in-out property <float> jog-z-speed: 10;
    in-out property <bool> invert-x;
    in-out property <bool> invert-y;
    in-out property <bool> invert-z;
    callback go-to(float, float, float);
    // Real toolhead speed, mm/s.
    in property <float> live-velocity;
    // Extruder: chosen length and speed (indexes into the prototype's options).
    in-out property <int> extrude-length: 2;
    in-out property <int> extrude-rate: 1;
    // What this printer can do (its config, macros and Moonraker components), and the
    // live values behind those rows.
    in property <bool> has-pause-layer;
    in property <int> pause-at-layer;
    in property <bool> pause-next;
    in-out property <float> pause-layer-pick;
    callback pause-at(int);
    callback pause-next-layer(bool);
    in property <bool> has-retraction;
    in property <float> retract-length;
    in property <float> retract-speed;
    in property <float> unretract-extra;
    in property <float> unretract-speed;
    callback set-retraction(string, float);
    in property <bool> has-auto-shutdown;
    in-out property <bool> off-after-print;
    callback off-after(bool);
    in property <bool> has-timelapse;
    in-out property <bool> timelapse-on;
    callback set-timelapse(bool);
    callback save-z-offset();
    // No link: the attempt that failed last and seconds to the next (-1: none).
    in property <int> retry-attempt;
    in property <int> retry-in: -1;
    callback retry-now();
    // What the Klipper shutdown is about ("timer", "lost", ...), for plain words.
    in property <string> error-kind;
    in property <bool> has-spoolman;
    in property <[FormRow]> spool-rows;
    in property <string> active-spool;
    in property <bool> has-active-spool;
    callback list-spools();
    callback pick-spool(string);
    in property <[FormRow]> power-rows;
    in property <[FormRow]> pin-rows;
    callback device-toggled(string, bool);
    // Home: last print's material, file counts (-1 not known yet), loaded filament
    // (Spoolman's active spool, else what the filament wizard loaded).
    in property <string> last-material;
    in property <int> last-grams;
    // Wall-clock times, empty when the printer has no timezone set.
    in property <string> last-clock;
    in property <string> eta-clock;
    in property <int> files-local: -1;
    in property <int> files-usb;
    // The Files screen shows the USB stick instead of the printer's storage.
    in-out property <bool> files-on-usb;
    // Where the file list was scrolled to.
    in-out property <length> files-scroll;
    in property <string> spool-material;
    in property <color> spool-color;
    in property <string> loaded-material;
    in property <color> loaded-color;
    // Bed dryer: minutes left, -1 when off; chosen material and hours.
    in property <int> dryer-minutes-left: -1;
    in-out property <int> dry-material: 1;
    in-out property <float> dry-hours: 4;
    callback dry(float, int);
    // The print screensaver is up (set after idle time while printing).
    in-out property <bool> ambient;
    // Rivet's own settings, saved in Moonraker's database.
    callback save-flag(string, bool);
    callback save-number(string, float);
    in property <bool> can-extrude;
    in property <float> min-extrude-temp;
    callback set-fan(string, float);
    callback set-air(int);
    callback set-nozzle(float);
    callback set-bed(float);
    // Heater limits from the printer config; 0 until known.
    in property <float> max-nozzle;
    in property <float> max-bed;
    property <float> nozzle-limit: root.max-nozzle > 0 ? root.max-nozzle : 350;
    property <float> bed-limit: root.max-bed > 0 ? root.max-bed : 130;
    in-out property <int> heating-heater;
    callback refresh-files();
    callback open-file(string);
    callback delete-selected();
    callback delete-file(string);
    callback select-all(bool);

    // Search and order of the file grid; Rust rebuilds the grid on files-view-changed.
    in-out property <string> files-query;
    in-out property <string> files-sort: "new";
    callback files-view-changed();
    // Russian interface: the keyboard starts with Russian letters for file names.
    in property <bool> russian;
    // Moonraker's print queue: rows, count (-1: the printer has no queue), state
    // ("ready" prints on, "paused" waits for a start) and the jobs' total time.
    in property <[FormRow]> queue-rows;
    in property <int> queue-count: -1;
    in property <string> queue-state;
    in property <int> queue-minutes;
    callback queue-files([string]);
    callback queue-selected();
    callback queue-run(bool);
    callback queue-clear();
    callback refresh-queue();
    // Rename and move the open file.
    in-out property <string> rename-text;
    pure callback name-ok(string, string) -> bool;
    callback rename-file(string, string);
    // Where files of this storage can go: "" (the top) and its folders.
    in property <[string]> move-folders;
    callback move-file(string, string);
    callback copy-to-printer(string);

    // G-code files; the selection lives in the rows.
    in-out property <[FileItem]> files;
    in property <FileInfo> file-info;
    in-out property <int> selected-count;
    in-out property <bool> select-mode;
    in-out property <string> open-path;
    in-out property <string> open-name;
    // The folder of the open file ("" for the top).
    pure callback folder-of(string) -> string;
    property <string> open-folder: root.folder-of(root.open-path);
    // A file's name to show: no folder, no .gcode.
    pure callback file-title(string) -> string;

    // Live values for tuning and the light, straight from Klipper.
    in property <float> speed-percent: 100;
    in property <float> flow-percent: 100;
    in property <float> z-offset;
    in property <float> pressure-advance;
    in property <int> fan-percent;
    in property <[FanRow]> fan-bars;
    in property <[FanRow]> fan-extras;
    in property <[FanRow]> fan-autos;
    in-out property <int> air-mode: -1;
    in property <bool> has-light;
    in-out property <bool> light-on;
    in property <float> light-level;
    in property <string> light-name;
    in property <bool> light-white;
    // Seconds until each heater reaches its target; -1 when not known.
    in property <int> nozzle-eta: -1;
    in property <int> bed-eta: -1;
    // Heat presets, temperature graph and PID screens exist (not yet).
    in property <bool> has-heat-links;
    // Rivet's own setting, read from Moonraker's database.
    in-out property <bool> light-on-start;
    // Z offset when the tuning screen opened: the «was» of its stepper.
    in-out property <float> tune-z-start;
    // Which value the keypad is editing: "speed" | "flow" | "z" | "pa".
    property <string> keypad-target;
    callback firmware-restart();

    // Command feedback from the engine: "" | "not-connected" | "timeout" | "rpc".
    // For "rpc", `toast-detail` is the message Klipper or Moonraker gave.
    in-out property <string> toast-kind;
    in property <string> toast-detail;

    // Overlay on top of everything: "" | "cancel-print" | "keypad".
    in-out property <string> overlay;
    in-out property <string> keypad-title;
    in-out property <string> keypad-hint;
    in-out property <string> keypad-current;
    in-out property <float> keypad-min;
    in-out property <float> keypad-max: 999;
    in-out property <bool> keypad-negative;
    callback keypad-done(float);

    // Current screen. Rail sections: home, control, tools, settings, messages.
    in-out property <string> screen: "home";

    // Open the keypad for one of the tuning values: "speed" | "flow" | "z" | "pa".
    function open-tune-keypad(what: string) {
        root.keypad-target = what;
        root.keypad-negative = what == "z";
        root.keypad-title = what == "speed" ? @tr("Speed, %") : what == "flow" ? @tr("Flow, %") : what == "z" ? @tr("Z-offset, mm") : @tr("Pressure advance");
        root.keypad-current = what == "speed" ? "" + round(root.speed-percent) : what == "flow" ? "" + round(root.flow-percent) : what == "z" ? "" + round(root.z-offset * 100) / 100 : "" + round(root.pressure-advance * 1000) / 1000;
        root.keypad-min = what == "speed" ? 10 : what == "flow" ? 50 : what == "z" ? -2 : 0;
        root.keypad-max = what == "speed" ? 300 : what == "flow" ? 150 : what == "z" ? 2 : 1;
        root.keypad-hint = what == "speed" ? "10 … 300" : what == "flow" ? "50 … 150" : what == "z" ? "−2 … 2" : "0 … 1";
        root.overlay = "keypad";
    }

    // Keypad for a row of a generated screen: key, title, range, current value, decimals.
    function open-number(key: string, title: string, lo: float, hi: float, current: float, digits: int) {
        root.keypad-target = key;
        root.keypad-negative = lo < 0;
        root.keypad-title = title;
        root.keypad-current = "" + round(current * pow(10, digits)) / pow(10, digits);
        root.keypad-min = lo;
        root.keypad-max = hi;
        root.keypad-hint = Format.fixed(lo, digits) + " … " + Format.fixed(hi, digits);
        root.overlay = "keypad";
    }
    // A new value for a row of a generated screen, by the row's key.
    function form-set(key: string, v: float) {
        if (key == "speed") { root.set-speed(v); }
        else if (key == "flow") { root.set-flow(v); }
        else if (key == "z") { root.adjust-z(v - root.z-offset); }
        else if (key == "pa") { root.set-pressure-advance(v); }
        else if (key == "goto-x") { root.goto-x = v; }
        else if (key == "goto-y") { root.goto-y = v; }
        else if (key == "goto-z") { root.goto-z = v; }
        else if (key == "jog-xy") { root.jog-xy-speed = v; root.save-number("jog_xy_speed", v); }
        else if (key == "jog-z") { root.jog-z-speed = v; root.save-number("jog_z_speed", v); }
        else if (key == "pause-layer") { root.pause-layer-pick = v; }
        else if (key == "dry-hours") { root.dry-hours = v; }
        else if (key == "retract-length" || key == "retract-speed" || key == "unretract-extra" || key == "unretract-speed") { root.set-retraction(key, v); }
    }

    // Runout: the sensor sees no filament; the printer has load/unload macros.
    in property <bool> filament-out;
    in property <bool> has-load-macros;
    // The runout screen stays up from the pause it caused until the print goes on
    // or ends, also once new filament is in.
    in-out property <bool> runout;
    changed filament-out => { if (root.filament-out && root.print-state == "paused") { root.runout = true; } }

    property <bool> ready: root.link-state == "ready";
    property <bool> busy: root.ready && (root.print-state == "printing" || root.print-state == "paused");

    HorizontalLayout {
        Rail {
            active: !root.ready ? "" : (root.screen == "fans" || root.screen == "heating" || root.screen == "motion" || root.screen == "extruder" || root.screen == "light" || root.screen == "speed" || root.screen == "zoffset" || root.screen == "motion-more" || root.screen == "retraction" || root.screen == "dryer" || root.screen == "spools" || root.screen == "devices") ? "control"
                : (root.screen == "control" || root.screen == "tools" || root.screen == "settings" || root.screen == "messages") ? root.screen
                : (root.screen == "console" || root.screen == "macros") ? "tools"
                : "home";
            navigate(section) => { root.screen = section; }
            emergency-stop => { root.emergency-stop(); }
        }

        if root.ready && root.screen == "control": ControlScreen {
            nozzle: root.extruder-temp;
            nozzle-target: root.extruder-target;
            bed: root.bed-temp;
            bed-target: root.bed-target;
            max-nozzle: root.nozzle-limit;
            max-bed: root.bed-limit;
            fan-percent: root.fan-percent;
            light-text: root.has-light ? (root.light-on ? round(root.light-level) + "%" : @tr("off")) : "";
            speed-percent: round(root.speed-percent);
            z-offset: root.z-offset;
            has-devices: root.power-rows.length > 0 || root.pin-rows.length > 0;
            open(target) => {
                if (target == "zoffset") { root.tune-z-start = root.z-offset; }
                if (target == "fans" || target == "heating" || target == "motion" || target == "extruder" || target == "light" || target == "speed" || target == "zoffset" || target == "devices") { root.screen = target; }
            }
        }
        if root.ready && root.screen == "light": LightForm {
            light-shown: root.has-light;
            light-on: root.light-on;
            brightness-shown: root.has-light;
            brightness-source: root.light-level;
            on-start-shown: root.has-light;
            on-start-on: root.light-on-start;
            back => { root.screen = "control"; }
            toggled(key, on) => {
                if (key == "light") { root.set-light-level(on ? 100 : 0); }
                if (key == "on-start") {
                    root.light-on-start = on;
                    root.save-flag("light_on_start", on);
                }
            }
            bar-committed(key, v) => { root.set-light-level(v); }
        }
        if root.ready && root.screen == "speed": SpeedForm {
            speed-num: root.speed-percent;
            flow-num: root.flow-percent;
            now-value: round(root.live-velocity) + " " + @tr("mm/s");
            back => { root.screen = "control"; }
            set-value(key, v) => { root.form-set(key, v); }
            edit-number(key, t, lo, hi, v, d) => { root.open-number(key, t, lo, hi, v, d); }
            activate(key) => { if (key == "reset-speed") { root.set-speed(100); root.set-flow(100); } }
        }
        if root.ready && root.screen == "zoffset": ZOffsetScreen {
            z-offset: root.z-offset;
            z-start: root.tune-z-start;
            back => { root.screen = "control"; }
            adjust-z(d) => { root.adjust-z(d); }
            edit(what) => { root.open-tune-keypad(what); }
            save => { root.save-z-offset(); }
        }
        if root.ready && root.screen == "motion": MotionScreen {
            pos-x: root.position-x;
            pos-y: root.position-y;
            pos-z: root.position-z;
            homed-x: root.homed-x;
            homed-y: root.homed-y;
            homed-z: root.homed-z;
            back => { root.screen = "control"; }
            // Inversion is for this screen's buttons only (Motion · more).
            move-axis(axis, d) => {
                root.move-axis(axis, (axis == 0 && root.invert-x) || (axis == 1 && root.invert-y) || (axis == 2 && root.invert-z) ? -d : d);
            }
            more => {
                root.goto-x = root.position-x;
                root.goto-y = root.position-y;
                root.goto-z = root.position-z;
                root.screen = "motion-more";
            }
            home-all => { root.home-all(); }
            motors-off => { root.motors-off(); }
        }
        if root.ready && root.screen == "extruder": ExtruderForm {
            nozzle-sub: root.min-extrude-temp > 0 ? @tr("to extrude, needs ≥ {}°", round(root.min-extrude-temp))
                : root.can-extrude ? @tr("hot enough to extrude") : @tr("too cold to extrude");
            nozzle-value: round(root.extruder-temp) + "° / " + round(root.extruder-target) + "°";
            length-sel: root.extrude-length;
            rate-sel: root.extrude-rate;
            extrude-enabled: root.can-extrude;
            retract-enabled: root.can-extrude;
            spools-shown: root.has-spoolman;
            spools-sub: root.has-active-spool ? @tr("active: {}", root.active-spool) : @tr("no active spool");
            retraction-shown: root.has-retraction;
            retraction-sub: @tr("length {} mm", Format.fixed(root.retract-length, 1));
            dryer-sub: root.dryer-minutes-left >= 0 ? @tr("drying: {} left", Format.duration(root.dryer-minutes-left)) : @tr("the bed as a dryer");
            back => { root.screen = "control"; }
            picked(key, i) => {
                if (key == "length") { root.extrude-length = i; }
                if (key == "rate") { root.extrude-rate = i; }
            }
            activate(key) => {
                if (key == "extrude") { root.extrude(self.length-values[root.extrude-length], self.rate-values[root.extrude-rate]); }
                if (key == "retract") { root.extrude(-self.length-values[root.extrude-length], self.rate-values[root.extrude-rate]); }
                if (key == "spools") { root.list-spools(); root.screen = "spools"; }
                if (key == "retraction") { root.screen = "retraction"; }
                if (key == "dryer") { root.screen = "dryer"; }
            }
        }
        if root.ready && root.screen == "retraction": RetractionForm {
            retract-length-num: root.retract-length;
            retract-speed-num: root.retract-speed;
            unretract-extra-num: root.unretract-extra;
            unretract-speed-num: root.unretract-speed;
            back => { root.screen = "extruder"; }
            set-value(key, v) => { root.form-set(key, v); }
            edit-number(key, t, lo, hi, v, d) => { root.open-number(key, t, lo, hi, v, d); }
        }
        if root.ready && root.screen == "dryer": DryerForm {
            dry-material-sel: root.dry-material;
            dry-hours-num: root.dry-hours;
            dry-start-title: root.dryer-minutes-left >= 0 ? @tr("Stop drying") : @tr("Start drying");
            dry-start-sub: root.dryer-minutes-left >= 0 ? @tr("drying · {} left", Format.duration(root.dryer-minutes-left)) : @tr("the bed switches off by itself on time");
            back => { root.screen = "extruder"; }
            picked(key, i) => { if (key == "dry-material") { root.dry-material = i; } }
            set-value(key, v) => { root.form-set(key, v); }
            edit-number(key, t, lo, hi, v, d) => { root.open-number(key, t, lo, hi, v, d); }
            activate(key) => {
                if (key == "dry-start") {
                    if (root.dryer-minutes-left >= 0) { root.dry(0, 0); }
                    else { root.dry(self.dry-material-values[root.dry-material], round(root.dry-hours * 60)); }
                }
            }
        }
        if root.ready && root.screen == "spools": SpoolsForm {
            spools-items: root.spool-rows;
            spool-clear-enabled: root.has-active-spool;
            back => { root.screen = "extruder"; }
            activate(key) => { root.pick-spool(key); }
        }
        if root.ready && root.screen == "devices": DevicesForm {
            power-section-shown: root.power-rows.length > 0;
            power-items: root.power-rows;
            pins-section-shown: root.pin-rows.length > 0;
            pins-items: root.pin-rows;
            back => { root.screen = "control"; }
            toggled(key, on) => { root.device-toggled(key, on); }
        }
        if root.ready && root.screen == "motion-more": MotionMoreForm {
            goto-x-num: root.goto-x;
            goto-y-num: root.goto-y;
            goto-z-num: root.goto-z;
            goto-x-min: root.axis-min-x;
            goto-y-min: root.axis-min-y;
            goto-z-min: root.axis-min-z;
            goto-x-max: root.axis-max-x;
            goto-y-max: root.axis-max-y;
            goto-z-max: root.axis-max-z;
            goto-x-sub: Format.fixed(root.axis-min-x, 0) + " … " + Format.fixed(root.axis-max-x, 0);
            goto-y-sub: Format.fixed(root.axis-min-y, 0) + " … " + Format.fixed(root.axis-max-y, 0);
            goto-z-sub: Format.fixed(root.axis-min-z, 0) + " … " + Format.fixed(root.axis-max-z, 0);
            go-enabled: root.homed-x && root.homed-y && root.homed-z;
            jog-xy-num: root.jog-xy-speed;
            jog-z-num: root.jog-z-speed;
            invert-x-on: root.invert-x;
            invert-y-on: root.invert-y;
            invert-z-on: root.invert-z;
            back => { root.screen = "motion"; }
            set-value(key, v) => { root.form-set(key, v); }
            edit-number(key, t, lo, hi, v, d) => { root.open-number(key, t, lo, hi, v, d); }
            activate(key) => {
                if (key == "home-all") { root.run-gcode("G28"); }
                if (key == "home-xy") { root.run-gcode("G28 X Y"); }
                if (key == "home-z") { root.run-gcode("G28 Z"); }
                if (key == "go") { root.go-to(root.goto-x, root.goto-y, root.goto-z); }
            }
            toggled(key, on) => {
                if (key == "invert-x") { root.invert-x = on; root.save-flag("invert_x", on); }
                if (key == "invert-y") { root.invert-y = on; root.save-flag("invert_y", on); }
                if (key == "invert-z") { root.invert-z = on; root.save-flag("invert_z", on); }
            }
        }
        if root.ready && root.screen == "heating": HeatingScreen {
            nozzle: root.extruder-temp;
            nozzle-target: root.extruder-target;
            bed: root.bed-temp;
            bed-target: root.bed-target;
            max-nozzle: root.nozzle-limit;
            max-bed: root.bed-limit;
            heater <=> root.heating-heater;
            nozzle-eta: root.nozzle-eta;
            bed-eta: root.bed-eta;
            has-heat-links: root.has-heat-links;
            back => { root.screen = "control"; }
            set-target(which, t) => { if (which == 0) { root.set-nozzle(t); } else { root.set-bed(t); } }
            edit(which) => {
                root.keypad-target = which == 0 ? "nozzle" : "bed";
                root.keypad-negative = false;
                root.keypad-title = which == 0 ? @tr("Nozzle, °C") : @tr("Bed, °C");
                root.keypad-current = "" + round(which == 0 ? root.extruder-target : root.bed-target);
                root.keypad-min = 0;
                root.keypad-max = which == 0 ? root.nozzle-limit : root.bed-limit;
                root.keypad-hint = "0 … " + round(which == 0 ? root.nozzle-limit : root.bed-limit);
                root.overlay = "keypad";
            }
        }
        if root.ready && root.screen == "tools": ToolsScreen {
            macro-count: root.macros.length;
            open(target) => { root.screen = target; }
        }
        // The log is also open while Klipper is stopped («Log» on the error screen).
        if (root.ready || root.link-state == "error") && root.screen == "console": ConsoleScreen {
            lines: root.console-lines;
            text <=> root.console-text;
            keyboard-open <=> root.console-keyboard;
            back => { root.screen = root.ready ? "tools" : "home"; }
            run(script) => { root.run-gcode(script); }
            clear => { root.clear-console(); }
            apply-key(t, k) => { return root.apply-key(t, k); }
        }
        if root.ready && root.screen == "macros": MacrosScreen {
            macros: root.macros;
            back => { root.screen = "tools"; }
            pick(name) => { root.macro-pending = name; root.overlay = "run-macro"; }
        }
        // The rows open M2 screens; until those exist they do nothing.
        if root.ready && root.screen == "settings": SettingsForm { }
        if root.ready && root.screen == "fans": FansScreen {
            bars: root.fan-bars;
            extras: root.fan-extras;
            autos: root.fan-autos;
            air-mode <=> root.air-mode;
            back => { root.screen = "control"; }
            set-fan(object, v) => { root.set-fan(object, v); }
            set-air(mode) => { root.set-air(mode); }
        }
        if root.ready && root.screen == "more": MoreForm {
            layer-pause-shown: root.has-pause-layer;
            layer-pause-sub: root.pause-next ? @tr("At the next layer")
                : root.pause-at-layer > 0 ? @tr("pause at layer {}", root.pause-at-layer)
                : @tr("next or chosen");
            light-shown: root.has-light;
            light-on: root.light-on;
            timelapse-shown: root.has-timelapse;
            timelapse-on: root.timelapse-on;
            timelapse-sub: root.timelapse-on && root.busy ? @tr("recording") : "";
            off-after-shown: root.has-auto-shutdown;
            off-after-on: root.off-after-print;
            back => { root.screen = "home"; }
            activate(key) => {
                if (key == "layer-pause") {
                    root.pause-layer-pick = root.pause-at-layer > root.layer ? root.pause-at-layer : root.layer + 1;
                    root.screen = "layer-pause";
                }
            }
            toggled(key, on) => {
                if (key == "light") { root.set-light-level(on ? 100 : 0); }
                if (key == "timelapse") { root.timelapse-on = on; root.set-timelapse(on); }
                if (key == "off-after") { root.off-after-print = on; root.off-after(on); }
            }
        }
        if root.ready && root.screen == "layer-pause": LayerPauseForm {
            layer-now-value: root.total-layers > 0 ? @tr("layer {} of {}", root.layer, root.total-layers) : "—";
            pause-layer-num: root.pause-layer-pick;
            pause-layer-min: root.layer + 1;
            pause-layer-max: max(root.layer + 1, root.total-layers);
            pause-at-sub: root.pause-at-layer > 0 ? @tr("set for layer {}", root.pause-at-layer) : "";
            pause-next-sub: root.pause-next ? @tr("set") : "";
            back => { root.screen = "more"; }
            set-value(key, v) => { root.form-set(key, v); }
            edit-number(key, t, lo, hi, v, d) => { root.open-number(key, t, lo, hi, v, d); }
            activate(key) => {
                if (key == "pause-at") { root.pause-at(round(root.pause-layer-pick)); }
                if (key == "pause-next") { root.pause-next-layer(!root.pause-next); }
            }
        }
        if root.ready && root.screen == "tune": TuneForm {
            speed-num: root.speed-percent;
            flow-num: root.flow-percent;
            z-num: root.z-offset;
            z-was-num: root.tune-z-start;
            pa-num: root.pressure-advance;
            temps-sub: @tr("nozzle {}° · bed {}°", round(root.extruder-temp), round(root.bed-temp));
            fans-sub: @tr("part fan {}%", root.fan-percent);
            back => { root.screen = "home"; }
            set-value(key, v) => { root.form-set(key, v); }
            edit-number(key, t, lo, hi, v, d) => { root.open-number(key, t, lo, hi, v, d); }
            activate(key) => {
                if (key == "save-z") { root.save-z-offset(); }
                if (key == "temps") { root.screen = "heating"; }
                if (key == "fans") { root.screen = "fans"; }
                if (key == "reset-speed") { root.set-speed(100); root.set-flow(100); }
            }
        }

        if root.ready && root.screen == "home" && root.busy && root.runout: RunoutScreen {
            layer: root.layer;
            total-layers: root.total-layers;
            progress: root.progress;
            has-load-macros: root.has-load-macros;
            can-extrude: root.can-extrude;
            filament-back: !root.filament-out;
            unload => { root.run-gcode("UNLOAD_FILAMENT"); }
            load => { root.run-gcode("LOAD_FILAMENT"); }
            purge => { root.extrude(25, 5); }
            cancel => { root.overlay = "cancel-print"; }
            resume => { root.resume-print(); }
        }
        if root.ready && root.screen == "home" && root.busy && !root.runout: PrintingScreen {
            filename: root.filename;
            thumb: root.print-thumb;
            has-thumb: root.has-print-thumb;
            progress: root.progress;
            paused: root.print-state == "paused";
            remaining-minutes: root.remaining-minutes;
            elapsed-minutes: root.elapsed-minutes;
            layer: root.layer;
            total-layers: root.total-layers;
            nozzle: root.extruder-temp;
            nozzle-target: root.extruder-target;
            bed: root.bed-temp;
            bed-target: root.bed-target;
            pause => { root.pause-print(); }
            resume => { root.resume-print(); }
            tune => { root.tune-z-start = root.z-offset; root.screen = "tune"; }
            has-more: root.has-light || root.has-pause-layer || root.has-timelapse || root.has-auto-shutdown;
            eta-clock: root.eta-clock;
            more => { root.screen = "more"; }
            cancel => { root.overlay = "cancel-print"; }
        }
        if root.ready && root.screen == "home" && !root.busy && root.print-state == "complete" && !root.done-dismissed: PrintDoneScreen {
            filename: root.filename;
            thumb: root.print-thumb;
            has-thumb: root.has-print-thumb;
            elapsed-minutes: root.elapsed-minutes;
            bed: root.bed-temp;
            clock: root.last-name == root.filename ? root.last-clock : "";
            material: root.last-name == root.filename ? root.last-material : "";
            grams: root.last-name == root.filename ? root.last-grams : 0;
            dismiss => { root.done-dismissed = true; }
            again => { root.start-print(root.filename); root.done-dismissed = true; }
        }
        if root.ready && root.screen == "home" && !root.busy && !(root.print-state == "complete" && !root.done-dismissed): HomeScreen {
            nozzle: root.extruder-temp;
            nozzle-target: root.extruder-target;
            bed: root.bed-temp;
            bed-target: root.bed-target;
            last-name: root.last-name;
            last-minutes: root.last-minutes;
            last-days-ago: root.last-days-ago;
            last-completed: root.last-completed;
            max-nozzle: root.nozzle-limit;
            max-bed: root.bed-limit;
            last-thumb: root.last-thumb;
            has-last-thumb: root.has-last-thumb;
            last-material: root.last-material;
            files-local: root.files-local;
            files-usb: root.files-usb;
            material: root.has-active-spool && root.spool-material != "" ? root.spool-material : root.loaded-material;
            material-color: root.has-active-spool && root.spool-material != "" ? root.spool-color : root.loaded-color;
            print-again => { root.start-print(root.last-name); }
            open(target) => {
                if (target == "files") { root.files-scroll = 0; root.refresh-files(); root.screen = "files"; }
                if (target == "heating" || target == "heating-bed") { root.heating-heater = target == "heating-bed" ? 1 : 0; root.screen = "heating"; }
                // The filament wizard comes later in this wave; until then, the Extruder.
                if (target == "filament") { root.screen = "extruder"; }
            }
        }
        if root.ready && root.screen == "files": FilesScreen {
            files <=> root.files;
            local-count: root.files-local;
            usb-count: root.files-usb;
            on-usb <=> root.files-on-usb;
            scroll-y <=> root.files-scroll;
            storage-changed(usb) => { root.files-scroll = 0; root.refresh-files(); }
            select-mode <=> root.select-mode;
            selected-count <=> root.selected-count;
            queue-count: root.queue-count;
            query: root.files-query;
            queue => { root.refresh-queue(); root.screen = "queue"; }
            find => { root.screen = "files-find"; }
            queue-selected => { root.queue-selected(); root.select-mode = false; }
            back => { root.screen = "home"; }
            open(path) => {
                root.open-path = path;
                root.open-name = root.file-title(path);
                root.open-file(path);
                root.screen = "file";
            }
            select-all(on) => { root.select-all(on); }
            ask-delete => { root.overlay = "delete-files"; }
        }
        if root.ready && root.screen == "file": FileScreen {
            path: root.open-path;
            name: root.open-name;
            info: root.file-info;
            max-z: root.axis-max-z;
            back => { root.screen = "files"; }
            print-file => { root.start-print(root.open-path); root.screen = "home"; }
            loaded-material: root.has-active-spool && root.spool-material != "" ? root.spool-material : root.loaded-material;
            more => { root.screen = "file-actions"; }
        }
        if root.ready && root.screen == "file-actions": FileActionsForm {
            page-title: root.open-name;
            queue-shown: root.queue-count >= 0;
            move-shown: root.move-folders.length > 1;
            // A file on the USB stick can be copied to the printer's storage.
            copy-shown: root.files-on-usb;
            back => { root.screen = "file"; }
            activate(key) => {
                if (key == "delete") { root.overlay = "delete-file"; }
                if (key == "queue") { root.queue-files([root.open-path]); root.screen = "queue"; }
                if (key == "rename") { root.rename-text = root.open-name; root.screen = "file-rename"; }
                if (key == "move") { root.screen = "file-move"; }
                if (key == "copy") { root.copy-to-printer(root.open-path); root.screen = "files"; }
            }
        }
        if root.ready && root.screen == "files-find": FindScreen {
            query <=> root.files-query;
            sort <=> root.files-sort;
            cyrillic: root.russian;
            changed => { root.files-scroll = 0; root.files-view-changed(); }
            apply-key(t, k) => { return root.apply-key(t, k); }
            back => { root.screen = "files"; }
        }
        if root.ready && root.screen == "file-rename": RenameScreen {
            text <=> root.rename-text;
            cyrillic: root.russian;
            valid: root.name-ok(root.open-path, root.rename-text);
            apply-key(t, k) => { return root.apply-key(t, k); }
            done => { root.rename-file(root.open-path, root.rename-text); root.screen = "files"; }
            back => { root.screen = "file-actions"; }
        }
        if root.ready && root.screen == "file-move": MoveScreen {
            folders: root.move-folders;
            current: root.open-folder;
            picked(folder) => { root.move-file(root.open-path, folder); root.screen = "files"; }
            back => { root.screen = "file-actions"; }
        }
        if root.ready && root.screen == "queue": Rectangle {
            horizontal-stretch: 1;
            JobQueueForm {
                width: parent.width;
                height: parent.height;
                jobs-items: root.queue-rows;
                queue-run-shown: root.queue-count > 0;
                queue-run-title: root.queue-state == "paused" ? @tr("Start the queue") : @tr("Pause the queue");
                queue-run-sub: root.queue-state == "paused" ? @tr("total {}", Format.duration(root.queue-minutes))
                    : root.busy ? @tr("the next job starts when this print ends") : @tr("the next job starts when the printer is free");
                queue-clear-shown: root.queue-count > 0;
                back => { root.screen = "files"; }
                activate(key) => {
                    if (key == "queue-run") { root.queue-run(root.queue-state == "paused"); }
                    if (key == "queue-clear") { root.overlay = "clear-queue"; }
                    if (key != "queue-run" && key != "queue-clear") {
                        root.open-path = key;
                        root.open-name = root.file-title(key);
                        root.open-file(key);
                        root.screen = "file";
                    }
                }
            }
            if root.queue-count == 0: VerticalLayout {
                alignment: center;
                spacing: 8px;
                Text { text: @tr("The queue is empty"); color: Tokens.text; font-size: Tokens.title; font-weight: 800; horizontal-alignment: center; }
                Text { text: @tr("Add a file from its menu, or several at once with Select."); color: Tokens.text-dim; font-size: Tokens.body; horizontal-alignment: center; }
            }
        }
        if !root.ready && root.screen != "console": StatusScreen {
            state: root.link-state;
            message: root.klippy-message;
            kind: root.error-kind;
            progress: root.print-state == "error" || root.print-state == "printing" ? root.progress : 0;
            attempt: root.retry-attempt;
            retry-in: root.retry-in;
            restart-firmware => { root.firmware-restart(); }
            retry => { root.retry-now(); }
            log => { root.screen = "console"; }
        }
    }

    if root.toast-kind != "": Toast {
        x: Tokens.rail-width + Tokens.pad;
        y: root.height - self.height - Tokens.pad;
        width: root.width - Tokens.rail-width - 2 * Tokens.pad;
        text: root.toast-kind == "not-connected" ? @tr("No connection to the printer")
            : root.toast-kind == "timeout" ? @tr("The printer did not answer")
            : root.toast-detail;
        dismissed => { root.toast-kind = ""; }
    }
    if root.overlay == "cancel-print": StopDialog {
        title: @tr("Stop the print?");
        message: @tr("{}% of “{}” is done. This print cannot be resumed later.", round(root.progress * 100), root.file-title(root.filename));
        confirm-text: @tr("Stop printing");
        cancel-text: @tr("Don't stop");
        confirmed => { root.overlay = ""; root.cancel-print(); }
        cancelled => { root.overlay = ""; }
    }
    if root.overlay == "delete-files": Dialog {
        title: @tr("Delete {n} file?" | "Delete {n} files?" % root.selected-count);
        message: @tr("They are removed from the printer. This cannot be undone.");
        confirm-text: @tr("Delete");
        danger: true;
        confirmed => {
            root.overlay = "";
            root.delete-selected();
            root.select-mode = false;
            root.selected-count = 0;
        }
        cancelled => { root.overlay = ""; }
    }
    if root.overlay == "clear-queue": Dialog {
        title: @tr("Clear the queue?");
        message: @tr("{n} job is removed from the queue. The files stay." | "{n} jobs are removed from the queue. The files stay." % root.queue-count);
        confirm-text: @tr("Clear");
        danger: true;
        confirmed => { root.overlay = ""; root.queue-clear(); }
        cancelled => { root.overlay = ""; }
    }
    if root.overlay == "delete-file": Dialog {
        title: @tr("Delete this file?");
        message: root.open-name + "\n" + @tr("It is removed from the printer. This cannot be undone.");
        confirm-text: @tr("Delete");
        danger: true;
        confirmed => { root.overlay = ""; root.delete-file(root.open-path); root.screen = "files"; }
        cancelled => { root.overlay = ""; }
    }
    if root.overlay == "run-macro": Dialog {
        title: @tr("Run {}?", root.macro-pending);
        message: @tr("The macro starts at once on the printer.");
        confirm-text: @tr("Run");
        confirmed => { root.overlay = ""; root.run-gcode(root.macro-pending); }
        cancelled => { root.overlay = ""; }
    }
    if root.overlay == "keypad": Keypad {
        title: root.keypad-title;
        hint: root.keypad-hint;
        current: root.keypad-current;
        minimum: root.keypad-min;
        maximum: root.keypad-max;
        allow-negative: root.keypad-negative;
        done(v) => {
            root.overlay = "";
            root.keypad-done(v);
            if (root.keypad-target == "nozzle") { root.set-nozzle(v); }
            else if (root.keypad-target == "bed") { root.set-bed(v); }
            else { root.form-set(root.keypad-target, v); }
        }
        cancelled => { root.overlay = ""; }
    }
    // Above everything, rail included; a touch closes it and presses nothing below.
    if root.ambient && root.busy: AmbientScreen {
        progress: root.progress;
        remaining-minutes: root.remaining-minutes;
        eta-clock: root.eta-clock;
        layer: root.layer;
        total-layers: root.total-layers;
        nozzle: root.extruder-temp;
        bed: root.bed-temp;
        dismiss => { root.ambient = false; root.screen = "home"; }
    }
}
