import { Palette, Metrics } from "theme.slint";
import { TapButton, HeaterCard } from "components.slint";
import { Tokens } from "kit/tokens.slint";
import { Rail } from "kit/rail.slint";
import { ControlScreen } from "screens/control.slint";
import { SettingsScreen } from "screens/settings.slint";
import { FansScreen, PrintTuneScreen, PrintMoreScreen } from "screens/tune.slint";
import { Dialog, Keypad } from "kit/dialogs.slint";
import { Toast } from "kit/toast.slint";
import { HomeScreen } from "screens/home.slint";
import { PrintingScreen, PrintDoneScreen } from "screens/print.slint";

// Embedded into the binary (see build.rs): the printer has no system fonts.
import "../assets/fonts/Inter-Regular.ttf";
import "../assets/fonts/Inter-SemiBold.ttf";
import "../assets/fonts/Inter-Bold.ttf";

export component AppWindow inherits Window {
    width: 800px;
    height: 480px;
    default-font-family: "Inter";
    title: "Rivet";
    background: Tokens.bg;
    default-font-size: 16px;

    // "ready" | "startup" | "error" | "klippy-offline" | "offline"
    in property <string> link-state: "offline";
    in property <string> klippy-message;
    in property <float> extruder-temp;
    in property <float> extruder-target;
    in property <float> bed-temp;
    in property <float> bed-target;
    // standby | printing | paused | complete | cancelled | error
    in property <string> print-state;
    in property <string> filename;
    in property <float> progress;
    // -1 where the value is unknown (no estimate yet, slicer sent no layers).
    in property <int> remaining-minutes: -1;
    in property <int> elapsed-minutes;
    in property <int> layer: -1;
    in property <int> total-layers: -1;
    // Newest job in history; empty name when there is none.
    in property <string> last-name;
    in property <int> last-minutes;
    in property <int> last-days-ago: -1;
    in property <bool> last-completed: true;
    // "Done" screen was acknowledged; a new print resets it.
    property <bool> done-dismissed;
    changed print-state => {
        if (self.print-state != "complete") { self.done-dismissed = false; }
    }

    callback preheat(float, float);
    callback cooldown();
    callback home-all();
    callback pause-print();
    callback resume-print();
    callback cancel-print();
    callback emergency-stop();
    callback start-print(string);
    callback set-speed(float);
    callback set-flow(float);
    callback adjust-z(float);
    callback set-pressure-advance(float);
    callback set-light(bool);

    // Live values for tuning and the light, straight from Klipper.
    in property <float> speed-percent: 100;
    in property <float> flow-percent: 100;
    in property <float> z-offset;
    in property <float> pressure-advance;
    in property <int> fan-percent;
    in property <bool> has-light;
    in-out property <bool> light-on;
    in property <string> light-name;
    in property <bool> light-white;
    property <float> tune-z-start;
    // Which value the keypad is editing: "speed" | "flow" | "z" | "pa".
    property <string> keypad-target;
    callback firmware-restart();

    // Command feedback from the engine: "" | "not-connected" | "timeout" | "rpc".
    // For "rpc", `toast-detail` is the message Klipper or Moonraker gave.
    in-out property <string> toast-kind;
    in property <string> toast-detail;

    // Overlay on top of everything: "" | "cancel-print" | "keypad".
    in-out property <string> overlay;
    in-out property <string> keypad-title;
    in-out property <string> keypad-hint;
    in-out property <string> keypad-current;
    in-out property <float> keypad-min;
    in-out property <float> keypad-max: 999;
    in-out property <bool> keypad-negative;
    callback keypad-done(float);

    // Current screen. Rail sections: home, control, tools, settings, messages.
    in-out property <string> screen: "home";

    property <bool> ready: root.link-state == "ready";
    property <bool> busy: root.ready && (root.print-state == "printing" || root.print-state == "paused");

    HorizontalLayout {
        Rail {
            active: root.screen == "fans" ? "control" : root.screen == "tune" ? "home" : root.screen;
            navigate(section) => { root.screen = section; }
            emergency-stop => { root.emergency-stop(); }
        }

        if root.screen == "control": ControlScreen {
            open(target) => { root.screen = target == "fans" ? "fans" : root.screen; }
        }
        if root.screen == "settings": SettingsScreen { }
        if root.screen == "fans": FansScreen { back => { root.screen = "control"; } }
        if root.screen == "more": PrintMoreScreen {
            has-light: root.has-light;
            light-on <=> root.light-on;
            back => { root.screen = "home"; }
            set-light(on) => { root.set-light(on); }
        }
        if root.screen == "tune": PrintTuneScreen {
            speed: root.speed-percent;
            flow: root.flow-percent;
            z-offset: root.z-offset;
            z-start: root.tune-z-start;
            pressure-advance: root.pressure-advance;
            fan-percent: root.fan-percent;
            back => { root.screen = "home"; }
            open-fans => { root.screen = "fans"; }
            set-speed(p) => { root.set-speed(p); }
            set-flow(p) => { root.set-flow(p); }
            adjust-z(d) => { root.adjust-z(d); }
            set-pressure-advance(v) => { root.set-pressure-advance(v); }
            edit(what) => {
                root.keypad-target = what;
                root.keypad-negative = what == "z";
                root.keypad-title = what == "speed" ? @tr("Speed, %") : what == "flow" ? @tr("Flow, %") : what == "z" ? @tr("Z-offset, mm") : @tr("Pressure advance");
                root.keypad-current = what == "speed" ? "" + round(root.speed-percent) : what == "flow" ? "" + round(root.flow-percent) : what == "z" ? "" + round(root.z-offset * 100) / 100 : "" + round(root.pressure-advance * 1000) / 1000;
                root.keypad-min = what == "speed" ? 10 : what == "flow" ? 50 : what == "z" ? -2 : 0;
                root.keypad-max = what == "speed" ? 300 : what == "flow" ? 150 : what == "z" ? 2 : 1;
                root.keypad-hint = what == "speed" ? "10 … 300" : what == "flow" ? "50 … 150" : what == "z" ? "−2 … 2" : "0 … 1";
                root.overlay = "keypad";
            }
        }

        if root.screen == "home" && root.ready && root.busy: PrintingScreen {
            filename: root.filename;
            progress: root.progress;
            paused: root.print-state == "paused";
            remaining-minutes: root.remaining-minutes;
            elapsed-minutes: root.elapsed-minutes;
            layer: root.layer;
            total-layers: root.total-layers;
            nozzle: root.extruder-temp;
            nozzle-target: root.extruder-target;
            bed: root.bed-temp;
            bed-target: root.bed-target;
            pause => { root.pause-print(); }
            resume => { root.resume-print(); }
            tune => { root.tune-z-start = root.z-offset; root.screen = "tune"; }
            has-more: root.has-light;
            more => { root.screen = "more"; }
            cancel => { root.overlay = "cancel-print"; }
        }
        if root.screen == "home" && root.ready && !root.busy && root.print-state == "complete" && !root.done-dismissed: PrintDoneScreen {
            filename: root.filename;
            elapsed-minutes: root.elapsed-minutes;
            bed: root.bed-temp;
            dismiss => { root.done-dismissed = true; }
            again => { root.start-print(root.filename); root.done-dismissed = true; }
        }
        if root.screen == "home" && root.ready && !root.busy && !(root.print-state == "complete" && !root.done-dismissed): HomeScreen {
            nozzle: root.extruder-temp;
            nozzle-target: root.extruder-target;
            bed: root.bed-temp;
            bed-target: root.bed-target;
            last-name: root.last-name;
            last-minutes: root.last-minutes;
            last-days-ago: root.last-days-ago;
            last-completed: root.last-completed;
            print-again => { root.start-print(root.last-name); }
        }
        // Not ready (no link, Klipper starting or stopped): status and the way out.
        if root.screen == "home" && !root.ready: VerticalLayout {
            padding: 16px;
            spacing: Metrics.gap;

            // Status bar
            HorizontalLayout {
                height: Metrics.touch;
                spacing: 10px;

                Rectangle {
                    width: 12px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 12px;
                            height: 12px;
                            border-radius: 6px;
                            background: root.ready ? Palette.accent
                                : root.link-state == "startup" ? Palette.warn
                                : Palette.danger;
                        }
                    }
                }
                Text {
                    vertical-alignment: center;
                    color: Palette.text-dim;
                    overflow: elide;
                    text: root.link-state == "ready" ? @tr("Ready")
                        : root.link-state == "startup" ? @tr("Klipper is starting…")
                        : root.link-state == "error" ? @tr("Klipper error")
                        : root.link-state == "klippy-offline" ? @tr("Klipper is not running")
                        : @tr("No connection to Moonraker");
                }
                Rectangle { horizontal-stretch: 1; }
                TapButton {
                    width: 120px;
                    text: @tr("E-STOP");
                    base: Palette.danger;
                    enabled: root.link-state != "offline";
                    clicked => { root.emergency-stop(); }
                }
            }

            // Heaters
            HorizontalLayout {
                spacing: Metrics.gap;
                vertical-stretch: 0;
                HeaterCard { label: @tr("Nozzle"); known: root.ready; current: root.extruder-temp; target: root.extruder-target; }
                HeaterCard { label: @tr("Bed"); known: root.ready; current: root.bed-temp; target: root.bed-target; }
            }

            // Print card
            Rectangle {
                border-radius: Metrics.radius;
                background: Palette.surface;
                vertical-stretch: 1;

                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    Text {
                        text: root.busy ? root.filename : @tr("No active print");
                        color: Palette.text;
                        font-size: 18px;
                        font-weight: 600;
                        overflow: elide;
                    }

                    Rectangle {
                        height: 10px;
                        border-radius: 5px;
                        background: Palette.surface-hi;

                        Rectangle {
                            x: 0px;
                            height: parent.height;
                            width: root.busy ? parent.width * root.progress : 0px;
                            border-radius: 5px;
                            background: root.print-state == "paused" ? Palette.warn : Palette.accent;
                        }
                    }

                    HorizontalLayout {
                        spacing: Metrics.gap;

                        Text {
                            vertical-alignment: center;
                            color: Palette.text-dim;
                            text: root.busy ? round(root.progress * 100) + "%" : "";
                            font-size: 22px;
                            font-weight: 700;
                        }
                        Rectangle { horizontal-stretch: 1; }

                        if root.print-state == "printing": TapButton {
                            width: 140px;
                            text: @tr("Pause");
                            clicked => { root.pause-print(); }
                        }
                        if root.print-state == "paused": TapButton {
                            width: 140px;
                            text: @tr("Resume");
                            base: Palette.accent;
                            clicked => { root.resume-print(); }
                        }
                        if root.busy: TapButton {
                            width: 140px;
                            text: @tr("Stop");
                            fg: Palette.danger;
                            clicked => { root.overlay = "cancel-print"; }
                        }
                    }
                }
            }

            // Quick actions
            if !root.busy && root.link-state != "error": HorizontalLayout {
                spacing: Metrics.gap;
                vertical-stretch: 0;
                TapButton { text: "PLA"; enabled: root.ready; clicked => { root.preheat(210, 60); } }
                TapButton { text: "PETG"; enabled: root.ready; clicked => { root.preheat(240, 80); } }
                TapButton { text: @tr("Cool down"); enabled: root.ready; clicked => { root.cooldown(); } }
                TapButton { text: @tr("Home"); enabled: root.ready; clicked => { root.home-all(); } }
            }

            // Klipper shut down: show reason and the way out.
            if root.link-state == "error": HorizontalLayout {
                spacing: Metrics.gap;
                vertical-stretch: 0;
                Text {
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    color: Palette.danger;
                    text: root.klippy-message;
                    wrap: word-wrap;
                    overflow: elide;
                }
                TapButton {
                    width: 200px;
                    text: @tr("Firmware restart");
                    base: Palette.accent;
                    clicked => { root.firmware-restart(); }
                }
            }
        }
    }
    if root.toast-kind != "": Toast {
        x: Tokens.rail-width + Tokens.pad;
        y: root.height - self.height - Tokens.pad;
        width: root.width - Tokens.rail-width - 2 * Tokens.pad;
        text: root.toast-kind == "not-connected" ? @tr("No connection to the printer")
            : root.toast-kind == "timeout" ? @tr("The printer did not answer")
            : root.toast-detail;
        dismissed => { root.toast-kind = ""; }
    }
    if root.overlay == "cancel-print": Dialog {
        title: @tr("Cancel print?");
        message: root.filename + "\n" + @tr("The heaters turn off. The job cannot be resumed.");
        confirm-text: @tr("Cancel print");
        cancel-text: @tr("Keep printing");
        danger: true;
        confirmed => { root.overlay = ""; root.cancel-print(); }
        cancelled => { root.overlay = ""; }
    }
    if root.overlay == "keypad": Keypad {
        title: root.keypad-title;
        hint: root.keypad-hint;
        current: root.keypad-current;
        minimum: root.keypad-min;
        maximum: root.keypad-max;
        allow-negative: root.keypad-negative;
        done(v) => {
            root.overlay = "";
            root.keypad-done(v);
            if (root.keypad-target == "speed") { root.set-speed(v); }
            else if (root.keypad-target == "flow") { root.set-flow(v); }
            else if (root.keypad-target == "z") { root.adjust-z(v - root.z-offset); }
            else if (root.keypad-target == "pa") { root.set-pressure-advance(v); }
        }
        cancelled => { root.overlay = ""; }
    }
}
