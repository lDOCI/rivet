import { Palette, Metrics } from "theme.slint";

export component TapButton inherits Rectangle {
    in property <string> text;
    in property <color> base: Palette.surface-hi;
    in property <color> fg: Palette.text;
    in property <bool> enabled: true;
    callback clicked;

    min-height: Metrics.touch;
    min-width: Metrics.touch;
    border-radius: 12px;
    background: !root.enabled ? Palette.surface : touch.pressed ? root.base.darker(30%) : root.base;
    opacity: root.enabled ? 1.0 : 0.5;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.fg;
        font-size: 18px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component HeaterCard inherits Rectangle {
    in property <string> label;
    in property <float> current;
    in property <float> target;
    // False while Klipper isn't ready: values would be stale.
    in property <bool> known: true;

    border-radius: Metrics.radius;
    background: Palette.surface;

    VerticalLayout {
        padding: 16px;
        spacing: 2px;

        Text {
            text: root.label;
            color: Palette.text-dim;
            font-size: 16px;
        }
        Text {
            text: root.known ? round(root.current) + "°" : "—";
            color: Palette.text;
            font-size: 48px;
            font-weight: 700;
        }
        Text {
            text: !root.known ? "" : root.target > 0 ? @tr("target {}°", round(root.target)) : @tr("off");
            color: root.target > 0 ? Palette.heat : Palette.text-dim;
            font-size: 16px;
        }
    }
}

export component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;

    height: 64px;
    border-radius: 12px;
    background: root.active ? Palette.surface-hi : transparent;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: root.active ? Palette.accent : Palette.text-dim;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}
