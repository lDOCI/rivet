// Speed.dc.html
export component SpeedForm inherits FormScreen {
    // Скорость
    in property <bool> speed-shown: true;
    in property <string> speed-sub: @tr("of the slicer");
    in property <float> speed-num: 100;
    in property <float> speed-was-num: 100;
    // Поток
    in property <bool> flow-shown: true;
    in property <string> flow-sub: @tr("how much plastic");
    in property <float> flow-num: 100;
    in property <float> flow-was-num: 100;
    // Вернуть 100% / 100%
    in property <bool> reset-speed-shown: true;
    in property <string> reset-speed-sub: "";
    in property <bool> reset-speed-enabled: true;
    // Сейчас
    in property <bool> now-shown: true;
    in property <string> now-sub: @tr("real toolhead speed");
    in property <string> now-value;
    title: @tr("Speed and flow");
    intro: @tr("Above 150% quality and strength usually drop.");
    // A stepper's new value, clamped to its range and rounded to its decimals.
    callback set-value(string, float);
    // Type a stepper's value: key, title, min, max, current, decimals.
    callback edit-number(string, string, float, float, float, int);
    stepped(key, d) => {
        if (key == "speed") { root.set-value(key, max(10, min(300, round((root.speed-num + d) * 1) / 1))); }
        if (key == "flow") { root.set-value(key, max(50, min(150, round((root.flow-num + d) * 1) / 1))); }
    }
    edit(key) => {
        if (key == "speed") { root.edit-number(key, @tr("Speed, %"), 10, 300, root.speed-num, 0); }
        if (key == "flow") { root.edit-number(key, @tr("Flow, %"), 50, 150, root.flow-num, 0); }
    }
    bars: [];
    rows: [
        { kind: "fine", key: "speed", title: @tr("Speed"), sub: root.speed-sub, shown: root.speed-shown, value: Format.fixed(root.speed-num, 0) + "%", big: 10, small: 1, big-label: "10", small-label: "1", changed: round(root.speed-num * 1) != round(root.speed-was-num * 1), was: Format.fixed(root.speed-was-num, 0) + "%" },
        { kind: "fine", key: "flow", title: @tr("Flow"), sub: root.flow-sub, shown: root.flow-shown, value: Format.fixed(root.flow-num, 0) + "%", big: 5, small: 1, big-label: "5", small-label: "1", changed: round(root.flow-num * 1) != round(root.flow-was-num * 1), was: Format.fixed(root.flow-was-num, 0) + "%" },
        { kind: "action", key: "reset-speed", title: @tr("Back to 100% / 100%"), sub: root.reset-speed-sub, shown: root.reset-speed-shown, on: root.reset-speed-enabled },
        { kind: "info", key: "now", title: @tr("Now"), sub: root.now-sub, shown: root.now-shown, value: root.now-value }
    ];
}

// PrintTune.dc.html
export component TuneForm inherits FormScreen {
    // Скорость
    in property <bool> speed-shown: true;
    in property <string> speed-sub: @tr("of the slicer");
    in property <float> speed-num: 100;
    in property <float> speed-was-num: 100;
    // Поток
    in property <bool> flow-shown: true;
    in property <string> flow-sub: @tr("how much plastic");
    in property <float> flow-num: 100;
    in property <float> flow-was-num: 100;
    // Z-offset, мм
    in property <bool> z-shown: true;
    in property <string> z-sub: @tr("applies at once");
    in property <float> z-num: -0.12;
    in property <float> z-was-num: -0.12;
    // Сохранить Z-offset
    in property <bool> save-z-shown: true;
    in property <string> save-z-sub: @tr("saved after the print");
    in property <bool> save-z-enabled: true;
    // PA
    in property <bool> pa-shown: true;
    in property <string> pa-sub: "pressure advance";
    in property <float> pa-num: 0;
    // Температуры
    in property <bool> temps-shown: true;
    in property <string> temps-sub;
    in property <string> temps-value;
    // Вентиляторы
    in property <bool> fans-shown: true;
    in property <string> fans-sub;
    in property <string> fans-value;
    // Сбросить скорость и поток
    in property <bool> reset-speed-shown: true;
    in property <string> reset-speed-sub: @tr("back to 100%");
    in property <bool> reset-speed-enabled: true;
    title: @tr("Print tuning");
    // A stepper's new value, clamped to its range and rounded to its decimals.
    callback set-value(string, float);
    // Type a stepper's value: key, title, min, max, current, decimals.
    callback edit-number(string, string, float, float, float, int);
    stepped(key, d) => {
        if (key == "speed") { root.set-value(key, max(10, min(300, round((root.speed-num + d) * 1) / 1))); }
        if (key == "flow") { root.set-value(key, max(50, min(150, round((root.flow-num + d) * 1) / 1))); }
        if (key == "z") { root.set-value(key, max(-2, min(2, round((root.z-num + d) * 100) / 100))); }
        if (key == "pa") { root.set-value(key, max(0, min(1, round((root.pa-num + d) * 1000) / 1000))); }
    }
    edit(key) => {
        if (key == "speed") { root.edit-number(key, @tr("Speed, %"), 10, 300, root.speed-num, 0); }
        if (key == "flow") { root.edit-number(key, @tr("Flow, %"), 50, 150, root.flow-num, 0); }
        if (key == "z") { root.edit-number(key, @tr("Z-offset, mm"), -2, 2, root.z-num, 2); }
        if (key == "pa") { root.edit-number(key, "PA", 0, 1, root.pa-num, 3); }
    }
    bars: [];
    rows: [
        { kind: "fine", key: "speed", title: @tr("Speed"), sub: root.speed-sub, shown: root.speed-shown, value: Format.fixed(root.speed-num, 0) + "%", big: 10, small: 1, big-label: "10", small-label: "1", changed: round(root.speed-num * 1) != round(root.speed-was-num * 1), was: Format.fixed(root.speed-was-num, 0) + "%" },
        { kind: "fine", key: "flow", title: @tr("Flow"), sub: root.flow-sub, shown: root.flow-shown, value: Format.fixed(root.flow-num, 0) + "%", big: 5, small: 1, big-label: "5", small-label: "1", changed: round(root.flow-num * 1) != round(root.flow-was-num * 1), was: Format.fixed(root.flow-was-num, 0) + "%" },
        { kind: "fine", key: "z", title: @tr("Z-offset, mm"), sub: root.z-sub, shown: root.z-shown, value: Format.fixed(root.z-num, 2) + "", big: 0.05, small: 0.01, big-label: "0.05", small-label: "0.01", changed: round(root.z-num * 100) != round(root.z-was-num * 100), was: Format.fixed(root.z-was-num, 2) + "" },
        { kind: "action", key: "save-z", title: @tr("Save Z-offset"), sub: root.save-z-sub, shown: root.save-z-shown, on: root.save-z-enabled },
        { kind: "stepper", key: "pa", title: "PA", sub: root.pa-sub, shown: root.pa-shown, value: Format.fixed(root.pa-num, 3) + "", big: 0.005 },
        { kind: "link", key: "temps", title: @tr("Temperatures"), sub: root.temps-sub, shown: root.temps-shown, value: root.temps-value },
        { kind: "link", key: "fans", title: @tr("Fans"), sub: root.fans-sub, shown: root.fans-shown, value: root.fans-value },
        { kind: "action", key: "reset-speed", title: @tr("Reset speed and flow"), sub: root.reset-speed-sub, shown: root.reset-speed-shown, on: root.reset-speed-enabled }
    ];
}

