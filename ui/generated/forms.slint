// PidCal.dc.html
export component PidForm inherits FormScreen {
    // Нагреватель
    in property <bool> heater-shown: true;
    in property <string> heater-sub: "";
    in property <int> heater-sel: 0;
    // Температура
    in property <bool> temp-shown: true;
    in property <string> temp-sub: @tr("as for a normal print");
    in property <float> temp-num: 40;
    // Обдув во время
    in property <bool> fan-shown: true;
    in property <string> fan-sub: @tr("as when printing");
    in property <int> fan-sel: 1;
    // Текущие
    in property <bool> now-shown: true;
    in property <string> now-sub: "";
    in property <string> now-value;
    // Запустить
    in property <bool> run-shown: true;
    in property <string> run-sub: @tr("the heater switches on and off several times");
    in property <bool> run-enabled: true;
    title: @tr("Heating (PID)");
    // A stepper's new value, clamped to its range and rounded to its decimals.
    callback set-value(string, float);
    // Type a stepper's value: key, title, min, max, current, decimals.
    callback edit-number(string, string, float, float, float, int);
    stepped(key, d) => {
        if (key == "temp") { root.set-value(key, max(40, min(350, round((root.temp-num + d) * 1) / 1))); }
    }
    edit(key) => {
        if (key == "temp") { root.edit-number(key, @tr("Temperature, °"), 40, 350, root.temp-num, 0); }
    }
    bars: [];
    rows: [
        { kind: "seg", key: "heater", title: @tr("Heater"), sub: root.heater-sub, shown: root.heater-shown, opts: [@tr("Nozzle"), @tr("Bed")], sel: root.heater-sel },
        { kind: "stepper", key: "temp", title: @tr("Temperature"), sub: root.temp-sub, shown: root.temp-shown, value: Format.fixed(root.temp-num, 0) + "°", big: 5 },
        { kind: "seg", key: "fan", title: @tr("Part fan during it"), sub: root.fan-sub, shown: root.fan-shown, opts: [@tr("Off"), "50%", "100%"], sel: root.fan-sel },
        { kind: "info", key: "now", title: @tr("Now"), sub: root.now-sub, shown: root.now-shown, value: root.now-value },
        { kind: "action", key: "run", title: @tr("Start"), sub: root.run-sub, shown: root.run-shown, tone: "accent", on: root.run-enabled }
    ];
}

// PressureAdvance.dc.html
export component PaForm inherits FormScreen {
    // Pressure advance
    in property <bool> pa-shown: true;
    in property <string> pa-sub: @tr("now");
    in property <float> pa-num: 0;
    // Smooth time
    in property <bool> smooth-shown: true;
    in property <string> smooth-sub: "";
    in property <float> smooth-num: 0;
    // Применить
    in property <bool> apply-shown: true;
    in property <string> apply-sub: @tr("until a restart");
    in property <bool> apply-enabled: true;
    // Тестовая башня — later: needs a test-tower G-code file to print
    in property <bool> tower-shown: false;
    in property <string> tower-sub: @tr("prints PA 0→0.1 up the height, then enter the best layer's height");
    in property <bool> tower-enabled: true;
    title: "Pressure advance";
    // A stepper's new value, clamped to its range and rounded to its decimals.
    callback set-value(string, float);
    // Type a stepper's value: key, title, min, max, current, decimals.
    callback edit-number(string, string, float, float, float, int);
    stepped(key, d) => {
        if (key == "pa") { root.set-value(key, max(0, min(1, round((root.pa-num + d) * 1000) / 1000))); }
        if (key == "smooth") { root.set-value(key, max(0, min(0.2, round((root.smooth-num + d) * 1000) / 1000))); }
    }
    edit(key) => {
        if (key == "pa") { root.edit-number(key, "Pressure advance", 0, 1, root.pa-num, 3); }
        if (key == "smooth") { root.edit-number(key, @tr("Smooth time, s"), 0, 0.2, root.smooth-num, 3); }
    }
    bars: [];
    rows: [
        { kind: "stepper", key: "pa", title: "Pressure advance", sub: root.pa-sub, shown: root.pa-shown, value: Format.fixed(root.pa-num, 3) + "", big: 0.005 },
        { kind: "stepper", key: "smooth", title: "Smooth time", sub: root.smooth-sub, shown: root.smooth-shown, value: Format.fixed(root.smooth-num, 3) + " " + @tr("s"), big: 0.005 },
        { kind: "action", key: "apply", title: @tr("Apply"), sub: root.apply-sub, shown: root.apply-shown, tone: "accent", on: root.apply-enabled },
        { kind: "action", key: "tower", title: @tr("Test tower"), sub: root.tower-sub, shown: root.tower-shown, on: root.tower-enabled }
    ];
}

