// JobQueue.dc.html
export component JobQueueForm inherits FormScreen {
    // 1 · Benchy: a live list of link rows
    in property <[FormRow]> jobs-items;
    // Начать очередь
    in property <bool> queue-run-shown: true;
    in property <string> queue-run-title;
    in property <string> queue-run-sub;
    in property <bool> queue-run-enabled: true;
    // Ждать подтверждения между печатями — later: Moonraker's automatic_transition is a moonraker.conf option, not something a screen can switch
    in property <bool> queue-wait-shown: false;
    in property <string> queue-wait-sub: @tr("to take the part off the bed");
    in property <bool> queue-wait-on;
    // Очистить очередь
    in property <bool> queue-clear-shown: true;
    in property <string> queue-clear-sub: "";
    in property <bool> queue-clear-enabled: true;
    title: @tr("Print queue");
    // A stepper's new value, clamped to its range and rounded to its decimals.
    callback set-value(string, float);
    // Type a stepper's value: key, title, min, max, current, decimals.
    callback edit-number(string, string, float, float, float, int);
    stepped(key, d) => {
    }
    edit(key) => {
    }
    bars: [];
    rows: [
        
    ];
    rows-1: root.jobs-items;
    rows-2: [
        { kind: "action", key: "queue-run", title: root.queue-run-title, sub: root.queue-run-sub, shown: root.queue-run-shown, tone: "accent", on: root.queue-run-enabled },
        { kind: "toggle", key: "queue-wait", title: @tr("Wait for a tap between prints"), sub: root.queue-wait-sub, shown: root.queue-wait-shown, on: root.queue-wait-on },
        { kind: "action", key: "queue-clear", title: @tr("Clear the queue"), sub: root.queue-clear-sub, shown: root.queue-clear-shown, tone: "danger", on: root.queue-clear-enabled }
    ];
}

// MotionAdvanced.dc.html
export component MotionMoreForm inherits FormScreen {
    // ПАРКОВКА
    in property <bool> park-shown: true;
    in property <string> park-sub: "";
    // Все оси
    in property <bool> home-all-shown: true;
    in property <string> home-all-sub: "";
    in property <bool> home-all-enabled: true;
    // Только XY
    in property <bool> home-xy-shown: true;
    in property <string> home-xy-sub: "";
    in property <bool> home-xy-enabled: true;
    // Только Z
    in property <bool> home-z-shown: true;
    in property <string> home-z-sub: "";
    in property <bool> home-z-enabled: true;
    // ПЕРЕЙТИ В ТОЧКУ
    in property <bool> goto-shown: true;
    in property <string> goto-sub: "";
    // X
    in property <bool> goto-x-shown: true;
    in property <string> goto-x-sub;
    in property <float> goto-x-min: -112;
    in property <float> goto-x-max: 112;
    in property <float> goto-x-num: 0;
    // Y
    in property <bool> goto-y-shown: true;
    in property <string> goto-y-sub;
    in property <float> goto-y-min: -112;
    in property <float> goto-y-max: 112;
    in property <float> goto-y-num: 0;
    // Z
    in property <bool> goto-z-shown: true;
    in property <string> goto-z-sub;
    in property <float> goto-z-min: -10;
    in property <float> goto-z-max: 230;
    in property <float> goto-z-num: 0;
    // Поехать
    in property <bool> go-shown: true;
    in property <string> go-sub: "";
    in property <bool> go-enabled: true;
    // НАСТРОЙКИ ДЖОЙСТИКА
    in property <bool> jog-shown: true;
    in property <string> jog-sub: "";
    // Скорость XY
    in property <bool> jog-xy-shown: true;
    in property <string> jog-xy-sub: "";
    in property <float> jog-xy-num: 10;
    // Скорость Z
    in property <bool> jog-z-shown: true;
    in property <string> jog-z-sub: "";
    in property <float> jog-z-num: 1;
    // Инвертировать X
    in property <bool> invert-x-shown: true;
    in property <string> invert-x-sub: @tr("on this screen only");
    in property <bool> invert-x-on;
    // Инвертировать Y
    in property <bool> invert-y-shown: true;
    in property <string> invert-y-sub: "";
    in property <bool> invert-y-on;
    // Инвертировать Z
    in property <bool> invert-z-shown: true;
    in property <string> invert-z-sub: "";
    in property <bool> invert-z-on;
    title: @tr("Motion · more");
    // A stepper's new value, clamped to its range and rounded to its decimals.
    callback set-value(string, float);
    // Type a stepper's value: key, title, min, max, current, decimals.
    callback edit-number(string, string, float, float, float, int);
    stepped(key, d) => {
        if (key == "goto-x") { root.set-value(key, max(root.goto-x-min, min(root.goto-x-max, round((root.goto-x-num + d) * 1) / 1))); }
        if (key == "goto-y") { root.set-value(key, max(root.goto-y-min, min(root.goto-y-max, round((root.goto-y-num + d) * 1) / 1))); }
        if (key == "goto-z") { root.set-value(key, max(root.goto-z-min, min(root.goto-z-max, round((root.goto-z-num + d) * 1) / 1))); }
        if (key == "jog-xy") { root.set-value(key, max(10, min(600, round((root.jog-xy-num + d) * 1) / 1))); }
        if (key == "jog-z") { root.set-value(key, max(1, min(25, round((root.jog-z-num + d) * 1) / 1))); }
    }
    edit(key) => {
        if (key == "goto-x") { root.edit-number(key, @tr("X, mm"), root.goto-x-min, root.goto-x-max, root.goto-x-num, 0); }
        if (key == "goto-y") { root.edit-number(key, @tr("Y, mm"), root.goto-y-min, root.goto-y-max, root.goto-y-num, 0); }
        if (key == "goto-z") { root.edit-number(key, @tr("Z, mm"), root.goto-z-min, root.goto-z-max, root.goto-z-num, 0); }
        if (key == "jog-xy") { root.edit-number(key, @tr("XY speed, mm/s"), 10, 600, root.jog-xy-num, 0); }
        if (key == "jog-z") { root.edit-number(key, @tr("Z speed, mm/s"), 1, 25, root.jog-z-num, 0); }
    }
    bars: [];
    rows: [
        { kind: "section", key: "park", title: @tr("HOMING"), sub: root.park-sub, shown: root.park-shown },
        { kind: "action", key: "home-all", title: @tr("All axes"), sub: root.home-all-sub, shown: root.home-all-shown, on: root.home-all-enabled },
        { kind: "action", key: "home-xy", title: @tr("XY only"), sub: root.home-xy-sub, shown: root.home-xy-shown, on: root.home-xy-enabled },
        { kind: "action", key: "home-z", title: @tr("Z only"), sub: root.home-z-sub, shown: root.home-z-shown, on: root.home-z-enabled },
        { kind: "section", key: "goto", title: @tr("GO TO POSITION"), sub: root.goto-sub, shown: root.goto-shown },
        { kind: "stepper", key: "goto-x", title: "X", sub: root.goto-x-sub, shown: root.goto-x-shown, value: Format.fixed(root.goto-x-num, 0) + " " + @tr("mm"), big: 1 },
        { kind: "stepper", key: "goto-y", title: "Y", sub: root.goto-y-sub, shown: root.goto-y-shown, value: Format.fixed(root.goto-y-num, 0) + " " + @tr("mm"), big: 1 },
        { kind: "stepper", key: "goto-z", title: "Z", sub: root.goto-z-sub, shown: root.goto-z-shown, value: Format.fixed(root.goto-z-num, 0) + " " + @tr("mm"), big: 1 },
        { kind: "action", key: "go", title: @tr("Go"), sub: root.go-sub, shown: root.go-shown, tone: "accent", on: root.go-enabled },
        { kind: "section", key: "jog", title: @tr("JOG SETTINGS"), sub: root.jog-sub, shown: root.jog-shown },
        { kind: "stepper", key: "jog-xy", title: @tr("XY speed"), sub: root.jog-xy-sub, shown: root.jog-xy-shown, value: Format.fixed(root.jog-xy-num, 0) + " " + @tr("mm/s"), big: 10 },
        { kind: "stepper", key: "jog-z", title: @tr("Z speed"), sub: root.jog-z-sub, shown: root.jog-z-shown, value: Format.fixed(root.jog-z-num, 0) + " " + @tr("mm/s"), big: 1 },
        { kind: "toggle", key: "invert-x", title: @tr("Invert X"), sub: root.invert-x-sub, shown: root.invert-x-shown, on: root.invert-x-on },
        { kind: "toggle", key: "invert-y", title: @tr("Invert Y"), sub: root.invert-y-sub, shown: root.invert-y-shown, on: root.invert-y-on },
        { kind: "toggle", key: "invert-z", title: @tr("Invert Z"), sub: root.invert-z-sub, shown: root.invert-z-shown, on: root.invert-z-on }
    ];
}

// LayerPause.dc.html
export component LayerPauseForm inherits FormScreen {
    // Сейчас
    in property <bool> layer-now-shown: true;
    in property <string> layer-now-sub: "";
    in property <string> layer-now-value;
    // Пауза на слое
    in property <bool> pause-layer-shown: true;
    in property <string> pause-layer-sub: @tr("insert a magnet, change colour");
    in property <float> pause-layer-min: 77;
    in property <float> pause-layer-max: 180;
    in property <float> pause-layer-num: 77;
    // Поставить паузу
    in property <bool> pause-at-shown: true;
    in property <string> pause-at-sub;
    in property <bool> pause-at-enabled: true;
    // На следующем слое
    in property <bool> pause-next-shown: true;
    in property <string> pause-next-sub;
    in property <bool> pause-next-enabled: true;
    title: @tr("Pause at layer");
    // A stepper's new value, clamped to its range and rounded to its decimals.
    callback set-value(string, float);
    // Type a stepper's value: key, title, min, max, current, decimals.
    callback edit-number(string, string, float, float, float, int);
    stepped(key, d) => {
        if (key == "pause-layer") { root.set-value(key, max(root.pause-layer-min, min(root.pause-layer-max, round((root.pause-layer-num + d) * 1) / 1))); }
    }
    edit(key) => {
        if (key == "pause-layer") { root.edit-number(key, @tr("Pause at layer"), root.pause-layer-min, root.pause-layer-max, root.pause-layer-num, 0); }
    }
    bars: [];
    rows: [
        { kind: "info", key: "layer-now", title: @tr("Now"), sub: root.layer-now-sub, shown: root.layer-now-shown, value: root.layer-now-value },
        { kind: "stepper", key: "pause-layer", title: @tr("Pause at layer"), sub: root.pause-layer-sub, shown: root.pause-layer-shown, value: Format.fixed(root.pause-layer-num, 0) + "", big: 1 },
        { kind: "action", key: "pause-at", title: @tr("Set the pause"), sub: root.pause-at-sub, shown: root.pause-at-shown, tone: "accent", on: root.pause-at-enabled },
        { kind: "action", key: "pause-next", title: @tr("At the next layer"), sub: root.pause-next-sub, shown: root.pause-next-shown, on: root.pause-next-enabled }
    ];
}

// Retraction.dc.html
export component RetractionForm inherits FormScreen {
    // Длина ретракта
    in property <bool> retract-length-shown: true;
    in property <string> retract-length-sub: @tr("direct drive 0.4–2 mm");
    in property <float> retract-length-num: 0;
    // Скорость ретракта
    in property <bool> retract-speed-shown: true;
    in property <string> retract-speed-sub: "";
    in property <float> retract-speed-num: 5;
    // Доп. подача
    in property <bool> unretract-extra-shown: true;
    in property <string> unretract-extra-sub: @tr("after unretracting");
    in property <float> unretract-extra-num: 0;
    // Скорость подачи
    in property <bool> unretract-speed-shown: true;
    in property <string> unretract-speed-sub: "";
    in property <float> unretract-speed-num: 5;
    // Действует до перезапуска
    in property <bool> retract-note-shown: true;
    in property <string> retract-note-sub: @tr("for good: only in the printer config");
    in property <string> retract-note-value;
    title: @tr("Firmware retraction");
    intro: @tr("Works only when the slicer uses firmware retraction.");
    // A stepper's new value, clamped to its range and rounded to its decimals.
    callback set-value(string, float);
    // Type a stepper's value: key, title, min, max, current, decimals.
    callback edit-number(string, string, float, float, float, int);
    stepped(key, d) => {
        if (key == "retract-length") { root.set-value(key, max(0, min(6, round((root.retract-length-num + d) * 10) / 10))); }
        if (key == "retract-speed") { root.set-value(key, max(5, min(120, round((root.retract-speed-num + d) * 1) / 1))); }
        if (key == "unretract-extra") { root.set-value(key, max(0, min(2, round((root.unretract-extra-num + d) * 100) / 100))); }
        if (key == "unretract-speed") { root.set-value(key, max(5, min(120, round((root.unretract-speed-num + d) * 1) / 1))); }
    }
    edit(key) => {
        if (key == "retract-length") { root.edit-number(key, @tr("Retract length, mm"), 0, 6, root.retract-length-num, 1); }
        if (key == "retract-speed") { root.edit-number(key, @tr("Retract speed, mm/s"), 5, 120, root.retract-speed-num, 0); }
        if (key == "unretract-extra") { root.edit-number(key, @tr("Extra prime, mm"), 0, 2, root.unretract-extra-num, 2); }
        if (key == "unretract-speed") { root.edit-number(key, @tr("Prime speed, mm/s"), 5, 120, root.unretract-speed-num, 0); }
    }
    bars: [];
    rows: [
        { kind: "stepper", key: "retract-length", title: @tr("Retract length"), sub: root.retract-length-sub, shown: root.retract-length-shown, value: Format.fixed(root.retract-length-num, 1) + " " + @tr("mm"), big: 0.1 },
        { kind: "stepper", key: "retract-speed", title: @tr("Retract speed"), sub: root.retract-speed-sub, shown: root.retract-speed-shown, value: Format.fixed(root.retract-speed-num, 0) + " " + @tr("mm/s"), big: 5 },
        { kind: "stepper", key: "unretract-extra", title: @tr("Extra prime"), sub: root.unretract-extra-sub, shown: root.unretract-extra-shown, value: Format.fixed(root.unretract-extra-num, 2) + " " + @tr("mm"), big: 0.05 },
        { kind: "stepper", key: "unretract-speed", title: @tr("Prime speed"), sub: root.unretract-speed-sub, shown: root.unretract-speed-shown, value: Format.fixed(root.unretract-speed-num, 0) + " " + @tr("mm/s"), big: 5 },
        { kind: "info", key: "retract-note", title: @tr("Lasts until a restart"), sub: root.retract-note-sub, shown: root.retract-note-shown, value: root.retract-note-value }
    ];
}

// Dryer.dc.html
export component DryerForm inherits FormScreen {
    // Материал
    in property <bool> dry-material-shown: true;
    in property <string> dry-material-sub: @tr("bed temperature");
    in property <int> dry-material-sel: 1;
    // The options as numbers, for the app.
    out property <[float]> dry-material-values: [50, 65, 80, 55];
    // Время
    in property <bool> dry-hours-shown: true;
    in property <string> dry-hours-sub: "";
    in property <float> dry-hours-num: 1;
    // Начать сушку
    in property <bool> dry-start-shown: true;
    in property <string> dry-start-title;
    in property <string> dry-start-sub;
    in property <bool> dry-start-enabled: true;
    title: @tr("Filament drying");
    // A stepper's new value, clamped to its range and rounded to its decimals.
    callback set-value(string, float);
    // Type a stepper's value: key, title, min, max, current, decimals.
    callback edit-number(string, string, float, float, float, int);
    stepped(key, d) => {
        if (key == "dry-hours") { root.set-value(key, max(1, min(12, round((root.dry-hours-num + d) * 1) / 1))); }
    }
    edit(key) => {
        if (key == "dry-hours") { root.edit-number(key, @tr("Time, h"), 1, 12, root.dry-hours-num, 0); }
    }
    bars: [];
    rows: [
        { kind: "seg", key: "dry-material", title: @tr("Material"), sub: root.dry-material-sub, shown: root.dry-material-shown, opts: ["PLA 50°", "PETG 65°", "ABS 80°", "TPU 55°"], sel: root.dry-material-sel },
        { kind: "stepper", key: "dry-hours", title: @tr("Time"), sub: root.dry-hours-sub, shown: root.dry-hours-shown, value: Format.fixed(root.dry-hours-num, 0) + " " + @tr("h"), big: 1 },
        { kind: "action", key: "dry-start", title: root.dry-start-title, sub: root.dry-start-sub, shown: root.dry-start-shown, tone: "accent", on: root.dry-start-enabled }
    ];
}

