        { kind: "link", key: "screws", title: @tr("Bed screws"), sub: root.screws-sub, shown: root.screws-shown, value: root.screws-value, icon: "M12 3a4 4 0 1 0 0 8a4 4 0 1 0 0-8 M12 11v10 M10 14h4M10 17h4" },
        { kind: "link", key: "probe", title: "Z-offset", sub: root.probe-sub, shown: root.probe-shown, value: root.probe-value, icon: "M10 3h4v8l-2 3-2-3z M4 20h16 M12 16v1" },
        { kind: "link", key: "shaper", title: @tr("Vibrations"), sub: root.shaper-sub, shown: root.shaper-shown, value: root.shaper-value, icon: "M2 12c2-6 4-6 6 0s4 6 6 0 4-6 6 0" },
        { kind: "link", key: "belts", title: @tr("Belts"), sub: root.belts-sub, shown: root.belts-shown, value: root.belts-value, icon: "M5 8a4 4 0 1 0 0 8 M19 8a4 4 0 1 1 0 8 M5 8h14M5 16h14" },
        { kind: "link", key: "pid", title: @tr("Heating (PID)"), sub: root.pid-sub, shown: root.pid-shown, value: root.pid-value, icon: "M12 14V4a2 2 0 0 0-4 0v10a4 4 0 1 0 4 0" },
        { kind: "link", key: "pa", title: "Pressure advance", sub: root.pa-sub, shown: root.pa-shown, value: root.pa-value, icon: "M4 18 10 6l4 8 2-4 4 8" },
