    stepped(key, d) => {
    }
    edit(key) => {
    }
    bars: [{ key: "brightness", title: @tr("Brightness"), value: root.brightness-value, source: root.brightness-source, min: 10, max: 100, step: 5, big-step: 9, unit: "%", off-at-zero: false, shown: root.brightness-shown }];
    rows: [
        { kind: "seg", key: "sleep", title: @tr("Sleep after, min"), sub: root.sleep-sub, shown: root.sleep-shown, opts: ["1", "5", "10", "30", "∞"], sel: root.sleep-sel },
        { kind: "toggle", key: "awake", title: @tr("Stay on while printing"), sub: root.awake-sub, shown: root.awake-shown, on: root.awake-on },
        { kind: "seg", key: "rotate", title: @tr("Rotation"), sub: root.rotate-sub, shown: root.rotate-shown, opts: ["0°", "90°", "180°", "270°"], sel: root.rotate-sel },
        { kind: "action", key: "touch-cal", title: @tr("Touch calibration"), sub: root.touch-cal-sub, shown: root.touch-cal-shown, on: root.touch-cal-enabled }
    ];
}

