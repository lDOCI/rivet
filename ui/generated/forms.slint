    // ПЕРЕЗАПУСК
    in property <bool> restart-shown: true;
    in property <string> restart-sub: "";
    // Перезапустить Klipper
    in property <bool> klipper-shown: true;
    in property <string> klipper-sub: @tr("reads the config again");
    in property <bool> klipper-enabled: true;
    // Перезапустить прошивку
    in property <bool> firmware-shown: true;
    in property <string> firmware-sub: @tr("after a board error");
    in property <bool> firmware-enabled: true;
    // Перезапустить Moonraker
    in property <bool> moonraker-shown: true;
    in property <string> moonraker-sub: "";
    in property <bool> moonraker-enabled: true;
    // Перезапустить экран — later: needs the init script (M2) to bring the screen back
    in property <bool> screen-shown: false;
    in property <string> screen-sub: "";
    in property <bool> screen-enabled: true;
    // ПИТАНИЕ
    in property <bool> power-shown: true;
    in property <string> power-sub: "";
    // Выключить после печати
    in property <bool> off-after-shown: true;
    in property <string> off-after-sub: @tr("once it cools below 50°");
    in property <bool> off-after-on;
    // Перезагрузить принтер
    in property <bool> reboot-shown: true;
    in property <string> reboot-sub: "";
    in property <bool> reboot-enabled: true;
    // Выключить принтер
    in property <bool> shutdown-shown: true;
    in property <string> shutdown-sub: "";
    in property <bool> shutdown-enabled: true;
    // Загрузить стоковую прошивку
    in property <bool> stock-shown: true;
    in property <string> stock-sub;
    in property <bool> stock-enabled: true;
    // О СИСТЕМЕ
    in property <bool> about-shown: true;
    in property <string> about-sub: "";
    // Процессор
    in property <bool> cpu-shown: true;
    in property <string> cpu-sub: "";
    in property <string> cpu-value;
    // Память
    in property <bool> memory-shown: true;
    in property <string> memory-sub: "";
    in property <string> memory-value;
    // Диск
    in property <bool> disk-shown: true;
    in property <string> disk-sub: "";
    in property <string> disk-value;
    // Логи — later: log level is a start option (--log-level) for now
    in property <bool> logs-shown: false;
    in property <string> logs-sub: @tr("level");
    in property <int> logs-sel: 1;
    // Очистить место — later: which files are safe to remove is not settled
    in property <bool> clean-shown: false;
    in property <string> clean-sub: @tr("old logs, timelapses, preview cache");
    in property <bool> clean-enabled: true;
    // Сбросить настройки Rivet
    in property <bool> reset-shown: true;
    in property <string> reset-sub: @tr("Klipper is not touched");
    in property <bool> reset-enabled: true;
    title: @tr("System");
    // A stepper's new value, clamped to its range and rounded to its decimals.
    callback set-value(string, float);
    // Type a stepper's value: key, title, min, max, current, decimals.
    callback edit-number(string, string, float, float, float, int);
    stepped(key, d) => {
    }
    edit(key) => {
    }
    bars: [];
    rows: [
        { kind: "section", key: "restart", title: @tr("RESTART"), sub: root.restart-sub, shown: root.restart-shown },
        { kind: "action", key: "klipper", title: @tr("Restart Klipper"), sub: root.klipper-sub, shown: root.klipper-shown, on: root.klipper-enabled },
        { kind: "action", key: "firmware", title: @tr("Restart the firmware"), sub: root.firmware-sub, shown: root.firmware-shown, on: root.firmware-enabled },
        { kind: "action", key: "moonraker", title: @tr("Restart Moonraker"), sub: root.moonraker-sub, shown: root.moonraker-shown, on: root.moonraker-enabled },
        { kind: "action", key: "screen", title: @tr("Restart the screen"), sub: root.screen-sub, shown: root.screen-shown, on: root.screen-enabled },
        { kind: "section", key: "power", title: @tr("POWER"), sub: root.power-sub, shown: root.power-shown },
        { kind: "toggle", key: "off-after", title: @tr("Power off after the print"), sub: root.off-after-sub, shown: root.off-after-shown, on: root.off-after-on },
        { kind: "action", key: "reboot", title: @tr("Reboot the printer"), sub: root.reboot-sub, shown: root.reboot-shown, on: root.reboot-enabled },
        { kind: "action", key: "shutdown", title: @tr("Power off the printer"), sub: root.shutdown-sub, shown: root.shutdown-shown, tone: "danger", on: root.shutdown-enabled },
        { kind: "action", key: "stock", title: @tr("Boot the stock firmware"), sub: root.stock-sub, shown: root.stock-shown, on: root.stock-enabled },
        { kind: "section", key: "about", title: @tr("ABOUT"), sub: root.about-sub, shown: root.about-shown },
        { kind: "info", key: "cpu", title: @tr("Processor"), sub: root.cpu-sub, shown: root.cpu-shown, value: root.cpu-value },
        { kind: "info", key: "memory", title: @tr("Memory"), sub: root.memory-sub, shown: root.memory-shown, value: root.memory-value },
        { kind: "info", key: "disk", title: @tr("Disk"), sub: root.disk-sub, shown: root.disk-shown, value: root.disk-value },
        { kind: "seg", key: "logs", title: @tr("Logs"), sub: root.logs-sub, shown: root.logs-shown, opts: [@tr("Errors"), @tr("Info"), @tr("Debug")], sel: root.logs-sel },
        { kind: "action", key: "clean", title: @tr("Free up space"), sub: root.clean-sub, shown: root.clean-shown, on: root.clean-enabled },
        { kind: "action", key: "reset", title: @tr("Reset Rivet's settings"), sub: root.reset-sub, shown: root.reset-shown, tone: "danger", on: root.reset-enabled }
    ];
}

// Network.dc.html
export component NetworkForm inherits FormScreen {
    // Wi-Fi — later: switching the radio off from the screen would cut the printer off the network it is reached by
    in property <bool> wifi-shown: false;
    in property <string> wifi-sub: "";
    in property <bool> wifi-on;
    // Подключено
    in property <bool> connected-shown: true;
    in property <string> connected-title;
    in property <string> connected-sub;
    in property <string> connected-value;
    // ДОСТУПНЫЕ СЕТИ
    in property <bool> around-shown: true;
    in property <string> around-sub: "";
    // HomeNet_5G: a live list of link rows
    in property <[FormRow]> nets-items;
    // Скрытая сеть
    in property <bool> hidden-shown: true;
    in property <string> hidden-sub: @tr("type its name");
    in property <string> hidden-value;
    // ПРОЧЕЕ
    in property <bool> other-shown: true;
    in property <string> other-sub: "";
    // Имя хоста
    in property <bool> host-shown: true;
    in property <string> host-sub: "";
    in property <string> host-value;
    // Ethernet
    in property <bool> ethernet-shown: true;
    in property <string> ethernet-sub: "";
    in property <string> ethernet-value;
    title: @tr("Network");
    // A stepper's new value, clamped to its range and rounded to its decimals.
    callback set-value(string, float);
    // Type a stepper's value: key, title, min, max, current, decimals.
    callback edit-number(string, string, float, float, float, int);
    stepped(key, d) => {
    }
    edit(key) => {
    }
    bars: [];
    rows: [
        { kind: "toggle", key: "wifi", title: "Wi-Fi", sub: root.wifi-sub, shown: root.wifi-shown, on: root.wifi-on },
        { kind: "info", key: "connected", title: root.connected-title, sub: root.connected-sub, shown: root.connected-shown, value: root.connected-value },
        { kind: "section", key: "around", title: @tr("NETWORKS AROUND"), sub: root.around-sub, shown: root.around-shown }
    ];
    rows-1: root.nets-items;
    rows-2: [
        { kind: "link", key: "hidden", title: @tr("Hidden network"), sub: root.hidden-sub, shown: root.hidden-shown, value: root.hidden-value },
        { kind: "section", key: "other", title: @tr("OTHER"), sub: root.other-sub, shown: root.other-shown },
        { kind: "info", key: "host", title: @tr("Host name"), sub: root.host-sub, shown: root.host-shown, value: root.host-value },
        { kind: "info", key: "ethernet", title: "Ethernet", sub: root.ethernet-sub, shown: root.ethernet-shown, value: root.ethernet-value }
    ];
}

