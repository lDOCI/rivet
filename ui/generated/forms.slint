// Safety.dc.html
export component SafetyForm inherits FormScreen {
    // Удерживать «Стоп» 1 секунду
    in property <bool> hold-stop-shown: true;
    in property <string> hold-stop-sub: @tr("against a stray touch; otherwise it stops at once");
    in property <bool> hold-stop-on;
    // Если отмена зависла — аварийная остановка — later: needs a watchdog on CANCEL_PRINT, not built
    in property <bool> cancel-estop-shown: false;
    in property <string> cancel-estop-sub: "";
    in property <bool> cancel-estop-on;
    // Ждать перед E-stop — later: goes with the cancel watchdog
    in property <bool> estop-wait-shown: false;
    in property <string> estop-wait-sub: "";
    in property <float> estop-wait-num: 5;
    // Подтверждать запуск макросов
    in property <bool> confirm-macros-shown: true;
    in property <string> confirm-macros-sub: "";
    in property <bool> confirm-macros-on;
    // Уведомления — later: only errors pop up today
    in property <bool> notify-shown: false;
    in property <string> notify-sub: @tr("what pops up over the screen");
    in property <int> notify-sel: 1;
    title: @tr("Safety");
    // A stepper's new value, clamped to its range and rounded to its decimals.
    callback set-value(string, float);
    // Type a stepper's value: key, title, min, max, current, decimals.
    callback edit-number(string, string, float, float, float, int);
    stepped(key, d) => {
        if (key == "estop-wait") { root.set-value(key, max(5, min(60, round((root.estop-wait-num + d) * 1) / 1))); }
    }
    edit(key) => {
        if (key == "estop-wait") { root.edit-number(key, @tr("Wait before E-stop, s"), 5, 60, root.estop-wait-num, 0); }
    }
    bars: [];
    rows: [
        { kind: "toggle", key: "hold-stop", title: @tr("Hold Stop for 1 second"), sub: root.hold-stop-sub, shown: root.hold-stop-shown, on: root.hold-stop-on },
        { kind: "toggle", key: "cancel-estop", title: @tr("If a cancel hangs: emergency stop"), sub: root.cancel-estop-sub, shown: root.cancel-estop-shown, on: root.cancel-estop-on },
        { kind: "stepper", key: "estop-wait", title: @tr("Wait before E-stop"), sub: root.estop-wait-sub, shown: root.estop-wait-shown, value: Format.fixed(root.estop-wait-num, 0) + " " + @tr("s"), big: 5 },
        { kind: "toggle", key: "confirm-macros", title: @tr("Confirm before running macros"), sub: root.confirm-macros-sub, shown: root.confirm-macros-shown, on: root.confirm-macros-on },
        { kind: "seg", key: "notify", title: @tr("Notifications"), sub: root.notify-sub, shown: root.notify-shown, opts: [@tr("All"), @tr("Important"), @tr("Errors")], sel: root.notify-sel }
    ];
}

