// JobQueue.dc.html
export component JobQueueForm inherits FormScreen {
    // 1 · Benchy: a live list of link rows
    in property <[FormRow]> jobs-items;
    // Начать очередь
    in property <bool> queue-run-shown: true;
    in property <string> queue-run-title;
    in property <string> queue-run-sub;
    in property <bool> queue-run-enabled: true;
    // Ждать подтверждения между печатями — later: Moonraker's automatic_transition is a moonraker.conf option, not something a screen can switch
    in property <bool> queue-wait-shown: false;
    in property <string> queue-wait-sub: @tr("to take the part off the bed");
    in property <bool> queue-wait-on;
    // Очистить очередь
    in property <bool> queue-clear-shown: true;
    in property <string> queue-clear-sub: "";
    in property <bool> queue-clear-enabled: true;
    title: @tr("Print queue");
    // A stepper's new value, clamped to its range and rounded to its decimals.
    callback set-value(string, float);
    // Type a stepper's value: key, title, min, max, current, decimals.
    callback edit-number(string, string, float, float, float, int);
    stepped(key, d) => {
    }
    edit(key) => {
    }
    bars: [];
    rows: [
        
    ];
    rows-1: root.jobs-items;
    rows-2: [
        { kind: "action", key: "queue-run", title: root.queue-run-title, sub: root.queue-run-sub, shown: root.queue-run-shown, tone: "accent", on: root.queue-run-enabled },
        { kind: "toggle", key: "queue-wait", title: @tr("Wait for a tap between prints"), sub: root.queue-wait-sub, shown: root.queue-wait-shown, on: root.queue-wait-on },
        { kind: "action", key: "queue-clear", title: @tr("Clear the queue"), sub: root.queue-clear-sub, shown: root.queue-clear-shown, tone: "danger", on: root.queue-clear-enabled }
