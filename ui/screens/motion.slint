// Moving the toolhead and the Z axis by hand, and pushing filament.
import { Tokens } from "../kit/tokens.slint";
import { Icons } from "../kit/icons.slint";
import { Icon, BackButton, Header, PrimaryButton, SecondaryButton } from "../kit/controls.slint";
import { InfoRow, SegmentedRow } from "../kit/rows.slint";
import { ScrollList } from "../kit/scroll.slint";
import { Format } from "../kit/format.slint";

component Cell inherits Rectangle {
    width: 84px;
    height: 84px;
}

component MoveButton inherits Rectangle {
    in property <string> text;
    in property <bool> big;
    in property <bool> enabled: true;
    callback clicked;
    border-radius: Tokens.r-m;
    background: !root.enabled ? Tokens.surface-1 : ta.pressed ? Tokens.surface-3 : root.big ? Tokens.surface-3 : Tokens.surface-1;
    opacity: root.enabled ? 1 : 0.4;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    Text {
        text: root.text;
        color: root.big ? Tokens.text : Tokens.text-2;
        font-size: root.big ? 18px : 17px;
        font-weight: root.big ? 700 : 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

export component MotionScreen inherits Rectangle {
    horizontal-stretch: 1;
    in property <float> pos-x;
    in property <float> pos-y;
    in property <float> pos-z;
    // Klipper only moves axes it knows the position of.
    in property <bool> homed-x;
    in property <bool> homed-y;
    in property <bool> homed-z;
    callback back;
    callback move-axis(int, float);
    callback home-all;
    callback motors-off;
    // Motion · more: homing per axis, go to a point, jog settings.
    callback more;

    property <bool> any-homed: root.homed-x || root.homed-y || root.homed-z;
    // The big buttons' step, mm: 10, 50 or 100 (to run an axis end to end, as
    // after greasing it); the small ones stay 1.
    in-out property <int> big-step: 10;

    HorizontalLayout {
        padding: Tokens.pad;
        padding-right: 20px;
        spacing: 16px;
        GridLayout {
            width: 448px;
            spacing: 7px;
            Row {
                Cell { HorizontalLayout { alignment: start; VerticalLayout { alignment: start; BackButton { clicked => { root.back(); } } } } }
                Cell { }
                MoveButton { width: 84px; height: 84px; text: "Y +" + root.big-step; big: true; enabled: root.homed-y; clicked => { root.move-axis(1, root.big-step); } }
                Cell { }
                Rectangle {
                    width: 84px;
                    height: 84px;
                    border-radius: Tokens.r-m;
                    background: step-ta.pressed ? Tokens.surface-2 : Tokens.surface-1;
                    accessible-role: button;
                    accessible-label: @tr("Step {} mm", root.big-step);
                    accessible-action-default => { root.big-step = root.big-step == 10 ? 50 : root.big-step == 50 ? 100 : 10; }
                    VerticalLayout {
                        alignment: center;
                        Text { text: @tr("step"); color: Tokens.text-dim; font-size: 13px; horizontal-alignment: center; }
                        Text { text: root.big-step + " " + @tr("mm"); color: Tokens.accent; font-size: 18px; font-weight: 800; horizontal-alignment: center; }
                    }
                    step-ta := TouchArea { clicked => { root.big-step = root.big-step == 10 ? 50 : root.big-step == 50 ? 100 : 10; } }
                }
            }
            Row {
                Cell { }
                Cell { }
                MoveButton { width: 84px; height: 84px; text: "+1"; enabled: root.homed-y; clicked => { root.move-axis(1, 1); } }
                Cell { }
                Cell { }
            }
            Row {
                MoveButton { width: 84px; height: 84px; text: "X −" + root.big-step; big: true; enabled: root.homed-x; clicked => { root.move-axis(0, -root.big-step); } }
                MoveButton { width: 84px; height: 84px; text: "−1"; enabled: root.homed-x; clicked => { root.move-axis(0, -1); } }
                Rectangle {
                    width: 84px;
                    height: 84px;
                    border-radius: 42px;
                    background: home.pressed ? Tokens.accent.with-alpha(0.2) : Tokens.accent-soft;
                    accessible-role: button;
                    accessible-label: @tr("Home all axes");
                    accessible-action-default => { root.home-all(); }
                    Icon { d: Icons.home; size: 32px; color: Tokens.accent; }
                    home := TouchArea { clicked => { root.home-all(); } }
                }
                MoveButton { width: 84px; height: 84px; text: "+1"; enabled: root.homed-x; clicked => { root.move-axis(0, 1); } }
                MoveButton { width: 84px; height: 84px; text: "X +" + root.big-step; big: true; enabled: root.homed-x; clicked => { root.move-axis(0, root.big-step); } }
            }
            Row {
                Cell { }
                Cell { }
                MoveButton { width: 84px; height: 84px; text: "−1"; enabled: root.homed-y; clicked => { root.move-axis(1, -1); } }
                Cell { }
                Cell { }
            }
            Row {
                Cell { }
                Cell { }
                MoveButton { width: 84px; height: 84px; text: "Y −" + root.big-step; big: true; enabled: root.homed-y; clicked => { root.move-axis(1, -root.big-step); } }
                Cell { }
                Cell { }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 7px;
            Rectangle {
                height: 64px;
                border-radius: Tokens.r-m;
                background: Tokens.surface-1;
                if !root.any-homed: Text {
                    text: @tr("Motors are free: home first");
                    color: Tokens.warn-text;
                    font-size: 15px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                if root.any-homed: HorizontalLayout {
                    alignment: space-around;
                    Text { text: "X " + (root.homed-x ? Format.signed(root.pos-x, 1) : "—"); color: Tokens.text; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                    Text { text: "Y " + (root.homed-y ? Format.signed(root.pos-y, 1) : "—"); color: Tokens.text; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                    Text { text: "Z " + (root.homed-z ? Format.signed(root.pos-z, 1) : "—"); color: Tokens.text; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                }
            }
            MoveButton { vertical-stretch: 1; text: "Z +" + root.big-step; big: true; enabled: root.homed-z; clicked => { root.move-axis(2, root.big-step); } }
            MoveButton { vertical-stretch: 1; text: "Z +1"; enabled: root.homed-z; clicked => { root.move-axis(2, 1); } }
            MoveButton { vertical-stretch: 1; text: "Z −1"; enabled: root.homed-z; clicked => { root.move-axis(2, -1); } }
            MoveButton { vertical-stretch: 1; text: "Z −" + root.big-step; big: true; enabled: root.homed-z; clicked => { root.move-axis(2, -root.big-step); } }
            HorizontalLayout {
                spacing: 7px;
                SecondaryButton { text: @tr("Motors off"); min-height: 64px; clicked => { root.motors-off(); } }
                SecondaryButton { text: @tr("More…"); min-height: 64px; clicked => { root.more(); } }
            }
        }
    }
}
