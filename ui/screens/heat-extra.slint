// Heat presets (per material, saved in Moonraker's database) and the
// temperature graph. The prototype's HeatPresets and TempGraph pages.
import { Tokens } from "../kit/tokens.slint";
import { Icon, Header } from "../kit/controls.slint";
import { ScrollList } from "../kit/scroll.slint";

export struct HeatPreset { name: string, nozzle: int, bed: int }

component Nudge inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    callback clicked;
    width: 64px;
    height: 64px;
    border-radius: 16px;
    background: ta.pressed ? Tokens.surface-3 : Tokens.surface-2;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Text { text: root.glyph; color: Tokens.text; font-size: 26px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component TempStepper inherits HorizontalLayout {
    in property <string> what;
    in property <int> value;
    callback step(int);
    spacing: 8px;
    Nudge { glyph: "−"; label: root.what + " −5°"; clicked => { root.step(-5); } }
    Text { horizontal-stretch: 1; text: root.value + "°"; color: Tokens.text; font-size: 24px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
    Nudge { glyph: "+"; label: root.what + " +5°"; clicked => { root.step(5); } }
}

export component HeatPresetsScreen inherits VerticalLayout {
    horizontal-stretch: 1;
    in property <[HeatPreset]> presets;
    in property <int> max-nozzle: 300;
    in property <int> max-bed: 110;
    // Index, nozzle, bed: Rust keeps and saves the list.
    callback changed(int, int, int);
    callback back;
    padding: Tokens.pad;
    padding-bottom: 0;
    spacing: 10px;
    Header { title: @tr("Heat presets"); back-clicked => { root.back(); } }
    HorizontalLayout {
        padding-left: 118px;
        padding-right: 22px;
        spacing: 10px;
        Text { horizontal-stretch: 1; text: @tr("NOZZLE"); color: Tokens.text-faint; font-size: 13px; font-weight: 700; horizontal-alignment: center; }
        Text { horizontal-stretch: 1; text: @tr("BED"); color: Tokens.text-faint; font-size: 13px; font-weight: 700; horizontal-alignment: center; }
    }
    ScrollList {
        vertical-stretch: 1;
        for p[i] in root.presets: Rectangle {
            height: 96px;
            border-radius: 20px;
            background: Tokens.surface-1;
            HorizontalLayout {
                padding-left: 18px;
                padding-right: 8px;
                spacing: 10px;
                Text { width: 90px; text: p.name; color: Tokens.text; font-size: 18px; font-weight: 800; vertical-alignment: center; }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    TempStepper {
                        what: p.name + " " + @tr("nozzle");
                        value: p.nozzle;
                        step(d) => { root.changed(i, max(0, min(root.max-nozzle, p.nozzle + d)), p.bed); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    TempStepper {
                        what: p.name + " " + @tr("bed");
                        value: p.bed;
                        step(d) => { root.changed(i, p.nozzle, max(0, min(root.max-bed, p.bed + d))); }
                    }
                }
            }
        }
    }
}

// One line of the graph: path commands over a box 1000 high and 1000 × the
// area's aspect wide (a Path keeps its viewbox's proportions), its colour, and
// the legend text ("Nozzle 220° / 220°").
export struct GraphLine { path: string, color: color, legend: string }

export component TempGraphScreen inherits VerticalLayout {
    horizontal-stretch: 1;
    in property <[GraphLine]> lines;
    // Gridlines: their height (0..1 from the top) and label.
    in property <[{ y: float, label: string }]> grid;
    in property <int> minutes: 10;
    callback back;
    // Asks for fresh readings, drawn for this width / height of the plot.
    callback refresh(float);
    init => { root.refresh(area.width / area.height); }
    padding: Tokens.pad;
    spacing: 10px;
    Header {
        title: @tr("Temperature graph");
        back-clicked => { root.back(); }
        Text { text: @tr("last {} min", root.minutes); color: Tokens.text-dim; font-size: 15px; vertical-alignment: center; }
    }
    Rectangle {
        vertical-stretch: 1;
        border-radius: 22px;
        background: Tokens.surface-1;
        area := Rectangle {
            x: 22px;
            y: 22px;
            width: parent.width - 44px;
            height: parent.height - 44px;
            for g in root.grid: Rectangle {
                y: g.y * parent.height;
                height: 1px;
                background: Tokens.text.with-alpha(0.06);
                Text { x: 4px; y: -18px; text: g.label; color: Tokens.text-faint; font-size: 12px; }
            }
            for l in root.lines: Path {
                width: parent.width;
                height: parent.height;
                viewbox-width: 1000 * area.width / area.height;
                viewbox-height: 1000;
                commands: l.path;
                stroke: l.color;
                stroke-width: 2.5px;
            }
        }
        Timer { interval: 3s; running: true; triggered => { root.refresh(area.width / area.height); } }
        if root.lines.length == 0: Text { text: @tr("No readings yet"); color: Tokens.text-dim; font-size: Tokens.body; horizontal-alignment: center; vertical-alignment: center; }
    }
    HorizontalLayout {
        height: 24px;
        spacing: 22px;
        alignment: start;
        for l in root.lines: HorizontalLayout {
            spacing: 8px;
            VerticalLayout { alignment: center; Rectangle { width: 12px; height: 12px; border-radius: 6px; background: l.color; } }
            Text { text: l.legend; color: Tokens.text-2; font-size: 15px; vertical-alignment: center; }
        }
    }
}
