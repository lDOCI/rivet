// Shown in place of every screen while the printer cannot be used: no link
// to Moonraker, Klipper starting or not running, Klipper stopped with an error.
import { Tokens } from "../kit/tokens.slint";
import { Icon, PrimaryButton } from "../kit/controls.slint";

export component StatusScreen inherits Rectangle {
    horizontal-stretch: 1;
    // "offline" | "startup" | "klippy-offline" | "error"
    in property <string> state: "offline";
    // What Klipper itself said (error state).
    in property <string> message;
    callback restart-firmware;

    property <bool> is-error: root.state == "error";

    VerticalLayout {
        padding: 24px;
        padding-left: 40px;
        padding-right: 40px;
        alignment: center;
        spacing: 14px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 96px;
                height: 96px;
                border-radius: 32px;
                background: root.is-error ? Tokens.danger-soft : Tokens.surface-1;
                Icon {
                    d: root.is-error ? "M8 2.5h8l5.5 5.5v8L16 21.5H8L2.5 16V8z M12 7.5v5.5 M12 16.5v.5"
                        : root.state == "offline" ? "M2.5 2.5l19 19 M8.5 16a5 5 0 0 1 7 0 M5 12.5a10 10 0 0 1 5.3-2.8 M14.4 9.9A10 10 0 0 1 19 12.5 M2 9a15 15 0 0 1 4.4-2.8 M10.7 5.1A15 15 0 0 1 22 9"
                        : "M12 3v4 M12 17v4 M3 12h4 M17 12h4 M5.6 5.6l2.8 2.8 M15.6 15.6l2.8 2.8 M5.6 18.4l2.8-2.8 M15.6 8.4l2.8-2.8";
                    size: 48px;
                    weight: 1.8;
                    color: root.is-error ? Tokens.danger : Tokens.text-dim;
                }
            }
        }
        Text {
            text: root.state == "offline" ? @tr("No connection to the printer")
                : root.state == "startup" ? @tr("Klipper is starting")
                : root.state == "klippy-offline" ? @tr("Klipper is not running")
                : @tr("The printer has stopped");
            color: Tokens.text;
            font-size: 30px;
            font-weight: 800;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Text {
            text: root.state == "offline" ? @tr("Moonraker does not answer. Rivet keeps trying, and the screen updates by itself once the link is back.")
                : root.state == "startup" ? @tr("This takes a few seconds. The screen updates by itself.")
                : root.state == "klippy-offline" ? @tr("Moonraker is reachable, but Klipper is off or restarting. The screen updates by itself.")
                : @tr("Heaters and motors are off. A firmware restart usually brings the printer back.");
            color: Tokens.text-2;
            font-size: 17px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if root.is-error && root.message != "": Rectangle {
            border-radius: 18px;
            background: Tokens.surface-1;
            VerticalLayout {
                padding: 14px;
                padding-left: 16px;
                spacing: 6px;
                Text { text: @tr("Message from Klipper"); color: Tokens.text-faint; font-size: 13px; font-weight: 600; }
                Text { text: root.message; color: #fda4af; font-size: 15px; wrap: word-wrap; font-family: "monospace"; }
            }
        }
        if root.is-error: HorizontalLayout {
            alignment: center;
            PrimaryButton {
                width: 340px;
                text: @tr("Restart firmware");
                clicked => { root.restart-firmware(); }
            }
        }
    }
}
