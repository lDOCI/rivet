import { Tokens } from "../kit/tokens.slint";
import { Icons } from "../kit/icons.slint";
import { Header } from "../kit/controls.slint";
import { LinkRow } from "../kit/rows.slint";
import { ScrollList } from "../kit/scroll.slint";

export component SettingsScreen inherits VerticalLayout {
    horizontal-stretch: 1;
    callback open(string);
    padding: Tokens.pad;
    padding-bottom: 0;
    spacing: Tokens.gap-s;
    Header { title: @tr("Settings"); back: false; }
    ScrollList {
        vertical-stretch: 1;
        LinkRow { icon: Icons.wifi; title: @tr("Network"); clicked => { root.open("network"); } }
        LinkRow { icon: Icons.screen; title: @tr("Screen"); clicked => { root.open("screen"); } }
        LinkRow { icon: Icons.lock; title: @tr("Lock and PIN"); clicked => { root.open("lock"); } }
        LinkRow { icon: Icons.sound; title: @tr("Sound"); clicked => { root.open("sound"); } }
        LinkRow { icon: Icons.lang; title: @tr("Language and time"); clicked => { root.open("language"); } }
        LinkRow { icon: Icons.shield; title: @tr("Safety"); clicked => { root.open("safety"); } }
        LinkRow { icon: Icons.printer; title: @tr("Printers"); clicked => { root.open("printers"); } }
        LinkRow { icon: Icons.update; title: @tr("Updates"); clicked => { root.open("updates"); } }
        LinkRow { icon: Icons.chip; title: @tr("System"); sub: @tr("restart, power off, about"); clicked => { root.open("system"); } }
    }
}
