// Nozzle and bed temperature: drag the dial, nudge by 5, type a number, or
// pick a preset. The target is sent when the finger lifts.
import { Tokens } from "../kit/tokens.slint";
import { Icons } from "../kit/icons.slint";
import { Icon, BackButton, SecondaryButton } from "../kit/controls.slint";
import { HeatDial } from "../kit/dial.slint";

component Preset inherits Rectangle {
    in property <string> name;
    in property <int> temp;
    callback picked(int);
    horizontal-stretch: 1;
    height: 60px;
    border-radius: Tokens.r-s;
    background: ta.pressed ? Tokens.surface-2 : Tokens.surface-1;
    accessible-role: button;
    accessible-label: root.name + " " + root.temp + "°";
    accessible-action-default => { root.picked(root.temp); }
    VerticalLayout {
        alignment: center;
        spacing: 1px;
        Text { text: root.name; color: Tokens.text; font-size: 15px; font-weight: 800; horizontal-alignment: center; }
        Text { text: root.temp + "°"; color: Tokens.text-dim; font-size: 12px; horizontal-alignment: center; }
    }
    ta := TouchArea { clicked => { root.picked(root.temp); } }
}

// Nozzle / Bed switch: one plate, the chosen side filled (the prototype's tabs).
component HeaterTabs inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected;
    height: Tokens.header;
    border-radius: Tokens.r-m;
    background: Tokens.surface-1;
    HorizontalLayout {
        padding: 5px;
        spacing: 4px;
        for option[i] in root.options: Rectangle {
            preferred-width: 0px;
            min-width: 0px;
            horizontal-stretch: 1;
            border-radius: 15px;
            background: i == root.selected ? Tokens.accent : transparent;
            accessible-role: tab;
            accessible-label: option;
            accessible-checked: i == root.selected;
            accessible-action-default => { root.selected = i; }
            Text {
                text: option;
                color: i == root.selected ? Tokens.accent-ink : Tokens.text-2;
                font-size: 17px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea { clicked => { root.selected = i; } }
        }
    }
}

// Status chip: flame and a few words, as wide as its text.
component HeatChip inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    height: 36px;
    // As wide as the words: flame 16 + gap 8 + padding 2 x 14.
    width: label.preferred-width + 52px;
    border-radius: 18px;
    background: root.active ? #f9731621 : Tokens.surface-1;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        Icon { d: Icons.flame; size: 16px; weight: 2.2; color: root.active ? #fdba74 : Tokens.text-dim; y: (parent.height - self.height) / 2; }
        label := Text {
            text: root.text;
            color: root.active ? #fdba74 : Tokens.text-dim;
            font-size: 15px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

export component HeatingScreen inherits VerticalLayout {
    horizontal-stretch: 1;
    in property <float> nozzle;
    in property <float> nozzle-target;
    in property <float> bed;
    in property <float> bed-target;
    in property <float> max-nozzle: 350;
    in property <float> max-bed: 130;
    // 0 nozzle, 1 bed
    in-out property <int> heater;
    callback back;
    callback set-target(int, float);
    callback edit(int);

    property <bool> is-bed: root.heater == 1;
    property <float> current: root.is-bed ? root.bed : root.nozzle;
    property <float> target: root.is-bed ? root.bed-target : root.nozzle-target;
    property <float> maximum: root.is-bed ? root.max-bed : root.max-nozzle;

    padding: Tokens.pad;
    padding-bottom: 0;
    spacing: 10px;

    HorizontalLayout {
        height: Tokens.header;
        spacing: 14px;
        BackButton { clicked => { root.back(); } }
        HeaterTabs {
            horizontal-stretch: 1;
            options: [@tr("Nozzle") + " · " + round(root.nozzle) + "°", @tr("Bed") + " · " + round(root.bed) + "°"];
            selected <=> root.heater;
        }
        VerticalLayout {
            alignment: center;
            HeatChip {
                active: root.target > 0;
                text: root.target <= 0 ? @tr("switched off")
                    : root.current < root.target - 2 ? @tr("heating")
                    : root.current > root.target + 2 ? @tr("cooling to {}°", round(root.target))
                    : @tr("holding temperature");
            }
        }
    }

    HorizontalLayout {
        vertical-stretch: 1;
        spacing: 16px;
        VerticalLayout {
            width: 330px;
            alignment: center;
            HorizontalLayout {
                alignment: center;
                HeatDial {
                    current: root.current;
                    target: root.target;
                    maximum: root.maximum;
                    committed(v) => { root.set-target(root.heater, v); }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text { text: round(root.current) + "°"; color: Tokens.text; font-size: 76px; font-weight: 800; horizontal-alignment: center; }
                        Text { text: @tr("now"); color: Tokens.text-dim; font-size: 16px; horizontal-alignment: center; }
                    }
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 8px;
            HorizontalLayout {
                spacing: 10px;
                SecondaryButton {
                    width: 84px;
                    height: 84px;
                    text: "−";
                    radius: 22px;
                    font-size: 36px;
                    clicked => { root.set-target(root.heater, max(0, root.target - 5)); }
                }
                Text {
                    horizontal-stretch: 1;
                    text: round(root.target) + "°";
                    color: Tokens.text;
                    font-size: 56px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                SecondaryButton {
                    width: 84px;
                    height: 84px;
                    text: "+";
                    radius: 22px;
                    font-size: 36px;
                    clicked => { root.set-target(root.heater, min(root.maximum, root.target + 5)); }
                }
            }
            Rectangle {
                height: 60px;
                border-radius: Tokens.r-m;
                background: pad.pressed ? Tokens.surface-2 : Tokens.surface-1;
                accessible-role: button;
                accessible-label: @tr("Enter a number");
                accessible-action-default => { root.edit(root.heater); }
                HorizontalLayout {
                    alignment: center;
                    spacing: 10px;
                    Icon { d: Icons.keypad; size: 22px; weight: 1.9; color: Tokens.text; y: (parent.height - self.height) / 2; }
                    Text { text: @tr("Enter a number"); color: Tokens.text; font-size: 17px; font-weight: 600; vertical-alignment: center; }
                }
                pad := TouchArea { clicked => { root.edit(root.heater); } }
            }
            HorizontalLayout {
                spacing: 6px;
                Preset { name: "PLA"; temp: root.is-bed ? 60 : 210; picked(t) => { root.set-target(root.heater, t); } }
                Preset { name: "PETG"; temp: root.is-bed ? 80 : 240; picked(t) => { root.set-target(root.heater, t); } }
                Preset { name: "ABS"; temp: root.is-bed ? 100 : 250; picked(t) => { root.set-target(root.heater, t); } }
                Preset { name: "TPU"; temp: root.is-bed ? 50 : 225; picked(t) => { root.set-target(root.heater, t); } }
            }
            Rectangle {
                height: 56px;
                accessible-role: button;
                accessible-label: root.is-bed ? @tr("Turn the bed heater off") : @tr("Turn the nozzle heater off");
                accessible-action-default => { root.set-target(root.heater, 0); }
                Text {
                    text: root.is-bed ? @tr("Turn the bed heater off") : @tr("Turn the nozzle heater off");
                    color: Tokens.danger;
                    font-size: Tokens.body;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea { clicked => { root.set-target(root.heater, 0); } }
            }
        }
    }
}
