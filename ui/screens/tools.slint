// Tools: the hub, the console and the macro list.
import { Tokens } from "../kit/tokens.slint";
import { Icons } from "../kit/icons.slint";
import { Header, PrimaryButton, SecondaryButton } from "../kit/controls.slint";
import { Tile, ActionRow } from "../kit/rows.slint";
import { ScrollList } from "../kit/scroll.slint";
import { Keyboard } from "../kit/keyboard.slint";

// kind: 0 sent by the user, 1 answer, 2 notice (//), 3 error (!!)
export struct ConsoleLine {
    text: string,
    kind: int,
}

export component ToolsScreen inherits VerticalLayout {
    horizontal-stretch: 1;
    in property <int> macro-count;
    // Prints in the history; -1 until known.
    in property <int> history-total: -1;
    callback open(string);
    padding: Tokens.pad;
    spacing: Tokens.gap;
    Header { title: @tr("Tools"); back: false; }
    // The prototype's 4 × 2 grid.
    VerticalLayout {
        vertical-stretch: 1;
        alignment: center;
        GridLayout {
            spacing: Tokens.gap;
            Row {
                Tile { icon: Icons.calib; label: @tr("Calibrations"); sub: @tr("bed, probe, vibrations"); clicked => { root.open("calibrate"); } }
                Tile {
                    icon: Icons.macro;
                    label: @tr("Macros");
                    sub: @tr("{n} macro" | "{n} macros" % root.macro-count);
                    clicked => { root.open("macros"); }
                }
                Tile { icon: Icons.console; label: @tr("Console"); sub: @tr("G-code by hand"); clicked => { root.open("console"); } }
                Tile {
                    icon: Icons.history;
                    label: @tr("History");
                    sub: root.history-total >= 0 ? @tr("{n} print" | "{n} prints" % root.history-total) : "";
                    clicked => { root.open("history"); }
                }
            }
            Row {
                Tile { icon: Icons.limits; label: @tr("Limits"); sub: @tr("speed, acceleration"); clicked => { root.open("limits"); } }
                Tile { icon: Icons.sensor; label: @tr("Sensors"); sub: @tr("runout, temperatures"); clicked => { root.open("sensors"); } }
                Tile { icon: Icons.service; label: @tr("Service"); sub: @tr("filter, nozzle, rails"); clicked => { root.open("service"); } }
                Tile { icon: Icons.camera; label: @tr("Camera"); sub: @tr("and timelapse"); clicked => { root.open("camera"); } }
            }
        }
    }
}

export component ConsoleScreen inherits VerticalLayout {
    horizontal-stretch: 1;
    in property <[ConsoleLine]> lines;
    in-out property <string> text;
    in-out property <bool> keyboard-open;
    callback back;
    callback run(string);
    callback clear;
    callback apply-key(string, string) -> string;
    padding: Tokens.pad;
    padding-bottom: 8px;
    spacing: 8px;

    property <int> count: root.lines.length;
    changed count => { log.scroll-to-end(); }

    function send() {
        root.run(root.text);
        root.text = "";
        root.keyboard-open = false;
    }

    if !root.keyboard-open: Header {
        title: @tr("Console");
        back-clicked => { root.back(); }
        SecondaryButton { width: 120px; text: @tr("Clear"); font-size: 15px; clicked => { root.clear(); } }
    }
    log := ScrollList {
        vertical-stretch: 1;
        spacing: 4px;
        for line in root.lines: Text {
            text: line.text;
            wrap: word-wrap;
            font-size: 15px;
            color: line.kind == 0 ? Tokens.accent-hi : line.kind == 2 ? Tokens.warn-text : line.kind == 3 ? Tokens.danger : Tokens.text-2;
        }
    }
    if !root.keyboard-open: HorizontalLayout {
        height: 56px;
        spacing: 8px;
        for cmd in ["G28", "M105", "QUERY_ENDSTOPS", "STATUS", "M114"]: SecondaryButton {
            text: cmd;
            font-size: 15px;
            min-width: 0;
            clicked => { root.run(cmd); }
        }
    }
    HorizontalLayout {
        height: 60px;
        spacing: 8px;
        Rectangle {
            horizontal-stretch: 1;
            border-radius: 18px;
            background: Tokens.surface-1;
            border-width: root.keyboard-open ? 2px : 0;
            border-color: Tokens.accent;
            accessible-role: button;
            accessible-label: @tr("Command, tap to type");
            accessible-action-default => { root.keyboard-open = true; }
            HorizontalLayout {
                x: 18px;
                width: parent.width - 36px;
                Text {
                    horizontal-stretch: 0;
                    text: root.text != "" ? root.text : root.keyboard-open ? "" : @tr("G-code or macro");
                    color: root.text != "" ? Tokens.text : Tokens.text-faint;
                    font-size: 17px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                // The caret: drawn, the font has no thin bar.
                if root.keyboard-open: VerticalLayout {
                    alignment: center;
                    padding-left: 1px;
                    Rectangle { width: 2px; height: 22px; background: Tokens.accent; }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            TouchArea { clicked => { root.keyboard-open = true; } }
        }
        PrimaryButton {
            width: 130px;
            min-height: 60px;
            text: @tr("Send");
            enabled: root.text != "";
            clicked => { root.send(); }
        }
    }
    if root.keyboard-open: Keyboard {
        key(k) => {
            if (k == "⏎") { root.send(); } else { root.text = root.apply-key(root.text, k); }
        }
    }
}

export component MacrosScreen inherits VerticalLayout {
    horizontal-stretch: 1;
    in property <[string]> macros;
    callback back;
    callback pick(string);
    padding: Tokens.pad;
    padding-bottom: 0;
    spacing: Tokens.gap-s;
    Header { title: @tr("Macros"); back-clicked => { root.back(); } }
    ScrollList {
        vertical-stretch: 1;
        for name in root.macros: ActionRow {
            title: name;
            clicked => { root.pick(name); }
        }
    }
}

// A list to choose one item from (a time zone): the current one is marked.
export component PickScreen inherits VerticalLayout {
    horizontal-stretch: 1;
    in property <string> title;
    in property <[string]> items;
    in property <string> current;
    callback back;
    callback pick(string);
    padding: Tokens.pad;
    padding-bottom: 0;
    spacing: Tokens.gap-s;
    Header { title: root.title; back-clicked => { root.back(); } }
    ScrollList {
        vertical-stretch: 1;
        for item in root.items: ActionRow {
            title: item;
            sub: item == root.current ? @tr("chosen") : "";
            clicked => { root.pick(item); }
        }
    }
}
