// Touch calibration over the whole screen: four crosses, one after another,
// then a check where every touch leaves a dot, and save / again / reset.
import { Tokens } from "../kit/tokens.slint";
import { PrimaryButton, SecondaryButton } from "../kit/controls.slint";

component Cross inherits Rectangle {
    width: 64px;
    height: 64px;
    Rectangle { x: parent.width / 2 - 1.5px; width: 3px; background: Tokens.accent; }
    Rectangle { y: parent.height / 2 - 1.5px; height: 3px; background: Tokens.accent; }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        border-width: 3px;
        border-color: Tokens.accent;
    }
}

export component TouchCalScreen inherits Rectangle {
    // Cross centres (logical px), same order as touchcal::TARGETS.
    in property <[{ x: float, y: float }]> targets: [{ x: 70, y: 70 }, { x: 730, y: 70 }, { x: 730, y: 410 }, { x: 70, y: 410 }];
    // Mean miss before and after, px, once the four are in; -1 if the taps made no sense.
    in property <float> miss-before: -1;
    in property <float> miss-after: -1;
    callback begin;
    callback point(int, float, float);
    callback finish;
    callback keep;
    callback undo;
    callback reset;
    callback close;
    // 0..3: which cross; 4: checking.
    property <int> step;
    property <length> dot-x: -100px;
    property <length> dot-y: -100px;
    background: Tokens.bg;
    init => { root.step = 0; root.begin(); }
    TouchArea {
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.up) {
                if (root.step < 4) {
                    root.point(root.step, self.mouse-x / 1px, self.mouse-y / 1px);
                    root.step += 1;
                    if (root.step == 4) { root.finish(); }
                } else {
                    root.dot-x = self.mouse-x;
                    root.dot-y = self.mouse-y;
                }
            }
        }
    }
    if root.step < 4: Cross {
        x: root.targets[root.step].x * 1px - self.width / 2;
        y: root.targets[root.step].y * 1px - self.height / 2;
    }
    if root.step < 4: Text {
        x: 120px;
        width: parent.width - 240px;
        y: (parent.height - self.height) / 2;
        text: @tr("Touch the centre of the cross with your finger, as you usually tap. {} of 4.", root.step + 1);
        color: Tokens.text;
        font-size: Tokens.row-title;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    if root.step == 4: VerticalLayout {
        x: 140px;
        width: parent.width - 280px;
        y: 120px;
        height: parent.height - 160px;
        spacing: 12px;
        Text {
            text: root.miss-after < 0 ? @tr("These taps do not fit together: a cross was missed. Try again.")
                : @tr("Taps were off by {} px on average, now {} px. Tap anywhere to check: a dot shows where the touch lands.", round(root.miss-before), round(root.miss-after));
            color: root.miss-after < 0 ? Tokens.danger : Tokens.text;
            font-size: Tokens.body;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            spacing: 10px;
            if root.miss-after >= 0: PrimaryButton {
                text: @tr("Save");
                clicked => { root.keep(); root.close(); }
            }
            SecondaryButton {
                text: @tr("Again");
                min-height: Tokens.touch-primary;
                clicked => { root.undo(); root.step = 0; root.begin(); }
            }
            SecondaryButton {
                text: @tr("Reset");
                min-height: Tokens.touch-primary;
                clicked => { root.reset(); root.step = 0; root.begin(); }
            }
            SecondaryButton {
                text: @tr("Cancel");
                min-height: Tokens.touch-primary;
                clicked => { root.undo(); root.close(); }
            }
        }
    }
    if root.step == 4: Rectangle {
        x: root.dot-x - 8px;
        y: root.dot-y - 8px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: Tokens.heat-2;
    }
}
