// While printing, and when a print has just finished.
import { Tokens } from "../kit/tokens.slint";
import { Icons } from "../kit/icons.slint";
import { Icon, ActionTile, PrimaryButton, SecondaryButton } from "../kit/controls.slint";
import { Format } from "../kit/format.slint";
import { Thumb } from "../kit/thumb.slint";

component HeaterChip inherits Rectangle {
    in property <string> name;
    in property <float> current;
    in property <float> target;
    horizontal-stretch: 1;
    height: 56px;
    border-radius: Tokens.r-s;
    background: Tokens.surface-1;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: root.target > 0 ? Tokens.heat-2 : Tokens.text-faint;
            }
        }
        Text { text: root.name; color: Tokens.text-dim; font-size: Tokens.caption; vertical-alignment: center; horizontal-stretch: 1; }
        Text { text: round(root.current) + "°"; color: Tokens.text; font-size: 19px; font-weight: 700; vertical-alignment: center; }
    }
}

export component PrintingScreen inherits Rectangle {
    horizontal-stretch: 1;
    in property <string> filename;
    in property <image> thumb;
    in property <bool> has-thumb;
    in property <float> progress;
    in property <bool> paused;
    in property <int> remaining-minutes: -1;
    in property <int> elapsed-minutes;
    in property <int> layer: -1;
    in property <int> total-layers: -1;
    in property <float> nozzle;
    in property <float> nozzle-target;
    in property <float> bed;
    in property <float> bed-target;
    callback pause;
    callback resume;
    callback tune;
    callback cancel;
    callback more;
    // «More» only when this printer has something to put there.
    in property <bool> has-more;
    // "15:20" when the print should end; empty without a timezone or an estimate.
    in property <string> eta-clock;

    property <color> tone: root.paused ? Tokens.warn : Tokens.accent;
    property <float> p: max(0.0001, min(0.9999, root.progress));
    property <angle> sweep: -90deg + root.p * 360deg;

    HorizontalLayout {
        padding-top: Tokens.pad;
        padding-bottom: Tokens.pad;
        padding-left: Tokens.pad;
        padding-right: 20px;
        spacing: 22px;

        VerticalLayout {
            width: 300px;
            alignment: center;
            spacing: 12px;
            Rectangle {
                width: 300px;
                height: 300px;
                accessible-role: progress-indicator;
                accessible-label: @tr("Print progress");
                accessible-value: round(root.progress * 100);
                Path {
                    width: 300px;
                    height: 300px;
                    viewbox-width: 300;
                    viewbox-height: 300;
                    stroke: #171b21;
                    stroke-width: 12px;
                    commands: "M150 12 A138 138 0 1 1 149.99 12";
                }
                Path {
                    width: 300px;
                    height: 300px;
                    viewbox-width: 300;
                    viewbox-height: 300;
                    stroke: root.tone;
                    stroke-width: 12px;
                    stroke-line-cap: round;
                    // Path elements, not a command string: no locale in the numbers.
                    MoveTo { x: 150; y: 12; }
                    ArcTo {
                        radius-x: 138;
                        radius-y: 138;
                        x: 150 + 138 * cos(root.sweep);
                        y: 150 + 138 * sin(root.sweep);
                        large-arc: root.p > 0.5;
                        sweep: true;
                    }
                }
                Rectangle {
                    x: 26px;
                    y: 26px;
                    width: parent.width - 52px;
                    height: parent.height - 52px;
                    border-radius: self.width / 2;
                    background: #161a20;
                    // The software renderer does not clip images to a circle, so
                    // the preview is the square that fits inside it.
                    Thumb {
                        width: 168px;
                        height: 168px;
                        background: transparent;
                        icon-size: 96px;
                        source: root.thumb;
                        has: root.has-thumb;
                    }
                }
            }
            Text {
                text: root.filename;
                color: Tokens.text-2;
                font-size: 15px;
                font-weight: 600;
                horizontal-alignment: center;
                overflow: elide;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            padding-top: 6px;
            Rectangle {
                height: 34px;
                HorizontalLayout {
                    alignment: start;
                    Rectangle {
                        height: 34px;
                        border-radius: 17px;
                        background: Tokens.surface-1;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 14px;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle { width: 8px; height: 8px; border-radius: 4px; background: root.tone; }
                            }
                            Text {
                                text: root.paused ? @tr("Paused") : @tr("Printing");
                                color: root.tone;
                                font-size: 15px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
            HorizontalLayout {
                alignment: start;
                spacing: 2px;
                Text { text: round(root.progress * 100); color: Tokens.text; font-size: 92px; font-weight: 800; vertical-alignment: bottom; }
                Text { text: "%"; color: Tokens.text-dim; font-size: 44px; font-weight: 700; vertical-alignment: bottom; }
            }
            // Time left from the pace so far; before that, how long it has run.
            Text {
                text: root.remaining-minutes >= 0 ? @tr("{} left", Format.duration(root.remaining-minutes)) : @tr("{} in", Format.duration(root.elapsed-minutes));
                color: Tokens.text;
                font-size: 22px;
                font-weight: 700;
            }
            // When it ends (wall clock) and the layer, each only when known.
            if root.eta-clock != "" || (root.layer >= 0 && root.total-layers > 0): Text {
                text: (root.eta-clock != "" ? @tr("done at {}", root.eta-clock) : "")
                    + (root.eta-clock != "" && root.layer >= 0 && root.total-layers > 0 ? " · " : "")
                    + (root.layer >= 0 && root.total-layers > 0 ? @tr("layer {} of {}", root.layer, root.total-layers) : "");
                color: Tokens.text-dim;
                font-size: 15px;
            }
            Rectangle { height: 16px; }
            HorizontalLayout {
                spacing: 8px;
                HeaterChip { name: @tr("Nozzle"); current: root.nozzle; target: root.nozzle-target; }
                HeaterChip { name: @tr("Bed"); current: root.bed; target: root.bed-target; }
            }
            Rectangle { vertical-stretch: 1; }
            // Four equal tiles, 84 px high, at the bottom (the prototype's grid).
            HorizontalLayout {
                spacing: 10px;
                height: 84px;
                if !root.paused: ActionTile { preferred-width: 0px; min-width: 0px; horizontal-stretch: 1; icon: "M10 4.5v15 M16 4.5v15"; text: @tr("Pause"); clicked => { root.pause(); } }
                if root.paused: ActionTile { preferred-width: 0px; min-width: 0px; horizontal-stretch: 1; icon: "M7.5 4.8v14.4a1 1 0 0 0 1.5.86l11.6-7.2a1 1 0 0 0 0-1.72L9 3.94a1 1 0 0 0-1.5.86z"; filled: true; text: @tr("Resume"); clicked => { root.resume(); } }
                ActionTile { preferred-width: 0px; min-width: 0px; horizontal-stretch: 1; icon: Icons.control; text: @tr("Tune"); clicked => { root.tune(); } }
                if root.has-more: ActionTile { preferred-width: 0px; min-width: 0px; horizontal-stretch: 1; icon: Icons.more; filled: true; text: @tr("More"); clicked => { root.more(); } }
                ActionTile { preferred-width: 0px; min-width: 0px; horizontal-stretch: 1; icon: "M5 5h14v14H5z"; filled: true; danger: true; text: @tr("Stop print"); clicked => { root.cancel(); } }
            }
        }
    }
}

export component PrintDoneScreen inherits Rectangle {
    horizontal-stretch: 1;
    in property <string> filename;
    in property <image> thumb;
    in property <bool> has-thumb;
    in property <int> elapsed-minutes;
    in property <float> bed;
    // From the history entry of this print: wall-clock end (needs a timezone),
    // filament type and planned grams from the slicer. Empty / 0 when not known.
    in property <string> clock;
    in property <string> material;
    in property <int> grams;
    callback dismiss;
    callback again;
    HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 24px;
        padding-bottom: Tokens.pad;
        spacing: 28px;
        VerticalLayout {
            width: 250px;
            alignment: start;
            Rectangle {
                width: 250px;
                height: 250px;
                Thumb {
                    border-radius: Tokens.r-xl;
                    icon-size: 120px;
                    source: root.thumb;
                    has: root.has-thumb;
                }
                Rectangle {
                    x: parent.width - self.width - 14px;
                    y: 14px;
                    width: 48px;
                    height: 48px;
                    border-radius: 24px;
                    background: Tokens.accent;
                    Icon { d: "M5 12.5l4.5 4.5L19 7"; size: 28px; weight: 2.6; color: Tokens.accent-ink; }
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            Text {
                text: root.clock != "" ? @tr("Done") + " · " + root.clock : @tr("Done");
                color: Tokens.accent-hi;
                font-size: 15px;
                font-weight: 700;
            }
            Rectangle { height: 10px; }
            Text { text: root.filename; color: Tokens.text; font-size: 32px; font-weight: 800; letter-spacing: -0.64px; overflow: elide; }
            Rectangle { height: 16px; }
            HorizontalLayout {
                spacing: 10px;
                height: 68px;
                Rectangle {
                    preferred-width: 0px;
                    min-width: 0px;
                    horizontal-stretch: 1;
                    border-radius: 18px;
                    background: Tokens.surface-1;
                    VerticalLayout {
                        padding-left: 14px;
                        alignment: center;
                        spacing: 2px;
                        Text { text: @tr("Time"); color: Tokens.text-dim; font-size: 13px; }
                        Text { text: Format.duration(root.elapsed-minutes); color: Tokens.text; font-size: 22px; font-weight: 800; }
                    }
                }
                // Filament: only when the slicer said how much and what.
                Rectangle {
                    preferred-width: 0px;
                    min-width: 0px;
                    horizontal-stretch: 1;
                    border-radius: 18px;
                    background: root.grams > 0 ? Tokens.surface-1 : transparent;
                    if root.grams > 0: VerticalLayout {
                        padding-left: 14px;
                        alignment: center;
                        spacing: 2px;
                        Text { text: @tr("Filament"); color: Tokens.text-dim; font-size: 13px; }
                        Text { text: @tr("{} g", root.grams) + (root.material != "" ? " " + root.material : ""); color: Tokens.text; font-size: 22px; font-weight: 800; }
                    }
                }
            }
            Rectangle { height: 14px; }
            if root.bed > 45: Text {
                text: @tr("Bed {}° — {} comes off easier once it cools.", round(root.bed), root.material != "" ? root.material : @tr("the part"));
                color: Tokens.text-dim;
                font-size: 15px;
                wrap: word-wrap;
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 10px;
                height: 80px;
                SecondaryButton { preferred-width: 0px; min-width: 0px; horizontal-stretch: 10; text: @tr("Done"); font-size: 18px; radius: 22px; clicked => { root.dismiss(); } }
                PrimaryButton { preferred-width: 0px; min-width: 0px; horizontal-stretch: 14; text: @tr("Print it again"); clicked => { root.again(); } }
            }
        }
    }
}

// The print screensaver (prototype: Ambient): full screen, no rail, big progress.
export component AmbientScreen inherits Rectangle {
    in property <float> progress;
    in property <int> remaining-minutes: -1;
    in property <string> eta-clock;
    in property <int> layer: -1;
    in property <int> total-layers: -1;
    in property <float> nozzle;
    in property <float> bed;
    callback dismiss;
    x: 0;
    y: 0;
    width: 800px;
    height: 480px;
    background: #050607;
    accessible-role: button;
    accessible-label: @tr("Print {}%, tap to open", round(root.progress * 100));
    property <float> p: max(0.0001, min(0.9999, root.progress));
    property <angle> sweep: -90deg + root.p * 360deg;
    HorizontalLayout {
        padding-top: 40px;
        padding-bottom: 40px;
        padding-left: 48px;
        padding-right: 48px;
        spacing: 48px;
        alignment: start;
        Rectangle {
            width: 360px;
            height: 360px;
            y: (parent.height - self.height) / 2;
            // Band r 158–174 (the prototype's r 166, width 16): this renderer strokes
            // inside the line, so the line runs at the outer edge.
            Path {
                width: 360px;
                height: 360px;
                viewbox-width: 360;
                viewbox-height: 360;
                stroke: #111418;
                stroke-width: 16px;
                commands: "M180 6 A174 174 0 1 1 179.99 6";
            }
            Path {
                width: 360px;
                height: 360px;
                viewbox-width: 360;
                viewbox-height: 360;
                stroke: Tokens.accent-hi;
                stroke-width: 16px;
                stroke-line-cap: round;
                MoveTo { x: 180; y: 6; }
                ArcTo {
                    radius-x: 174;
                    radius-y: 174;
                    x: 180 + 174 * cos(root.sweep);
                    y: 180 + 174 * sin(root.sweep);
                    large-arc: root.p > 0.5;
                    sweep: true;
                }
            }
            HorizontalLayout {
                alignment: center;
                Text { text: round(root.progress * 100); color: Tokens.text; font-size: 132px; font-weight: 800; letter-spacing: -6.6px; vertical-alignment: center; }
                Text { text: "%"; color: #7d8792; font-size: 56px; font-weight: 800; vertical-alignment: center; y: 18px; }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 6px;
            if root.remaining-minutes >= 0: Text { text: @tr("Left"); color: #7d8792; font-size: 18px; font-weight: 600; }
            if root.remaining-minutes >= 0: Text { text: Format.duration(root.remaining-minutes); color: Tokens.text; font-size: 84px; font-weight: 800; letter-spacing: -2.52px; height: 84px; vertical-alignment: center; }
            if root.eta-clock != "": Text { text: @tr("done at {}", root.eta-clock); color: Tokens.text-2; font-size: 24px; }
            Rectangle { height: 31px; Rectangle { y: 18px; height: 1px; background: #1a1e23; } }
            if root.layer >= 0 && root.total-layers > 0: Text { text: @tr("layer {} of {}", root.layer, root.total-layers); color: Tokens.text-dim; font-size: 18px; }
            Text { text: @tr("nozzle {}° · bed {}°", round(root.nozzle), round(root.bed)); color: Tokens.text-dim; font-size: 18px; }
        }
    }
    Text {
        x: parent.width - self.width - 48px;
        y: parent.height - self.height - 22px;
        text: @tr("Tap to open");
        color: #4a525c;
        font-size: 14px;
    }
    TouchArea { clicked => { root.dismiss(); } }
}

component RunoutStep inherits Rectangle {
    in property <string> number;
    in property <string> title;
    in property <string> sub;
    in property <bool> enabled: true;
    callback clicked;
    height: 72px;
    border-radius: 20px;
    background: ta.pressed && root.enabled ? Tokens.surface-2 : Tokens.surface-1;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: root.title;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 20px;
                background: Tokens.surface-2;
                Text { text: root.number; color: #5eead4; font-size: 17px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text { text: root.title; color: Tokens.text; font-size: 17px; font-weight: 700; overflow: elide; }
            Text { text: root.sub; color: Tokens.text-dim; font-size: 14px; overflow: elide; }
        }
    }
    ta := TouchArea { clicked => { if (root.enabled) { root.clicked(); } } }
}

// The runout sensor paused the print: what happened on the left, the way back
// on the right. The prototype's Runout page.
export component RunoutScreen inherits Rectangle {
    horizontal-stretch: 1;
    in property <int> layer: -1;
    in property <int> total-layers: -1;
    in property <float> progress;
    // The printer has LOAD_FILAMENT / UNLOAD_FILAMENT.
    in property <bool> has-load-macros;
    // Klipper lets the extruder move (hot enough).
    in property <bool> can-extrude;
    // The sensor sees filament again.
    in property <bool> filament-back;
    callback unload;
    callback load;
    callback purge;
    callback cancel;
    callback resume;
    HorizontalLayout {
        padding: Tokens.pad;
        spacing: 16px;
        Rectangle {
            width: 240px;
            border-radius: 24px;
            background: #fbbf2414;
            VerticalLayout {
                padding: 20px;
                spacing: 0;
                HorizontalLayout {
                    alignment: start;
                    Rectangle {
                        width: 52px;
                        height: 52px;
                        border-radius: 18px;
                        background: #fbbf2429;
                        Icon { d: Icons.pause; size: 28px; weight: 2.4; color: Tokens.warn; }
                    }
                }
                Rectangle { height: 14px; }
                Text { text: @tr("Out of filament"); color: Tokens.text; font-size: 24px; font-weight: 800; wrap: word-wrap; }
                Rectangle { height: 10px; }
                Text {
                    text: root.layer > 0 && root.total-layers > 0
                        ? @tr("Paused at layer {} of {}. The nozzle stays hot.", root.layer, root.total-layers)
                        : @tr("Paused at {}%. The nozzle stays hot.", round(root.progress * 100));
                    color: #c7cdd4;
                    font-size: 15px;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
                Rectangle {
                    height: 64px;
                    border-radius: 18px;
                    background: cancel-ta.pressed ? #fb4b5e33 : Tokens.danger-soft;
                    accessible-role: button;
                    accessible-label: @tr("Cancel print");
                    accessible-action-default => { root.cancel(); }
                    Text { text: @tr("Cancel print"); color: Tokens.danger; font-size: 16px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    cancel-ta := TouchArea { clicked => { root.cancel(); } }
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 8px;
            if root.has-load-macros: RunoutStep {
                number: "1";
                title: @tr("Unload what is left");
                sub: @tr("heat and pull the broken end out");
                clicked => { root.unload(); }
            }
            if root.has-load-macros: RunoutStep {
                number: "2";
                title: @tr("Load a new strand");
                sub: @tr("heat and feed it to the nozzle");
                clicked => { root.load(); }
            }
            RunoutStep {
                number: root.has-load-macros ? "3" : "1";
                title: @tr("Purge the nozzle");
                sub: root.can-extrude ? @tr("25 mm, until the colour runs clean") : @tr("the nozzle is not hot enough yet");
                enabled: root.can-extrude;
                clicked => { root.purge(); }
            }
            Rectangle { vertical-stretch: 1; }
            PrimaryButton {
                min-height: 80px;
                text: @tr("Resume print");
                sub: root.filament-back ? "" : @tr("the sensor sees no filament yet");
                enabled: root.filament-back;
                clicked => { root.resume(); }
            }
        }
    }
}
