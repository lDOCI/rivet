import { Tokens } from "../kit/tokens.slint";
import { Icons } from "../kit/icons.slint";
import { Header } from "../kit/controls.slint";
import { Tile } from "../kit/rows.slint";
import { Gauge } from "../kit/gauge.slint";
import { Format } from "../kit/format.slint";

export component ControlScreen inherits VerticalLayout {
    horizontal-stretch: 1;
    in property <float> nozzle;
    in property <float> nozzle-target;
    in property <float> bed;
    in property <float> bed-target;
    in property <float> max-nozzle: 350;
    in property <float> max-bed: 130;
    in property <int> fan-percent;
    // "" when the printer has no light.
    in property <string> light-text;
    in property <int> speed-percent: 100;
    in property <float> z-offset;
    // Moonraker power devices or user output pins exist (the Devices screen has rows).
    in property <bool> has-devices;
    callback open(string);
    padding: Tokens.pad;
    spacing: Tokens.gap;
    Header { title: @tr("Control"); back: false; }
    GridLayout {
        spacing: Tokens.gap;
        vertical-stretch: 1;
        Row {
            Tile {
                label: @tr("Heating");
                sub: (root.nozzle-target > 0 ? @tr("nozzle → {}°", round(root.nozzle-target)) : @tr("nozzle off")) + "\n" + (root.bed-target > 0 ? @tr("bed → {}°", round(root.bed-target)) : @tr("bed off"));
                clicked => { root.open("heating"); }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Gauge { current: root.nozzle; target: root.nozzle-target; maximum: root.max-nozzle; }
                    Gauge { current: root.bed; target: root.bed-target; maximum: root.max-bed; }
                }
            }
            Tile { icon: Icons.move; label: @tr("Motion"); sub: @tr("axes, homing, motors"); clicked => { root.open("motion"); } }
            Tile { icon: Icons.extruder; label: @tr("Extruder"); sub: @tr("extrude, load filament"); clicked => { root.open("extruder"); } }
            Tile { icon: Icons.fan; value: root.fan-percent + "%"; label: @tr("Part fan"); clicked => { root.open("fans"); } }
        }
        Row {
            Tile { icon: Icons.bulb; value: root.light-text != "" ? root.light-text : "—"; label: @tr("Light"); clicked => { root.open("light"); } }
            Tile { icon: Icons.gauge; value: root.speed-percent + "%"; label: @tr("Speed"); clicked => { root.open("speed"); } }
            Tile { icon: Icons.zoff; value: Format.signed(root.z-offset, 2) + " " + @tr("mm"); label: @tr("Z-offset"); clicked => { root.open("zoffset"); } }
            if root.has-devices: Tile { icon: Icons.plug; label: @tr("Devices"); sub: @tr("power, outputs"); clicked => { root.open("devices"); } }
        }
    }
}
