// G-code files on the printer: a grid, one-tap open, select several to delete.
import { Tokens } from "../kit/tokens.slint";
import { Icons } from "../kit/icons.slint";
import { Icon, Header, IconButton, PrimaryButton, SecondaryButton, DangerButton } from "../kit/controls.slint";
import { Format } from "../kit/format.slint";
import { ScrollList } from "../kit/scroll.slint";
import { Thumb } from "../kit/thumb.slint";

export struct FileItem {
    // Path under gcodes, what Moonraker takes back.
    path: string,
    name: string,
    days-ago: int,
    size-kb: int,
    selected: bool,
    thumb: image,
    has-thumb: bool,
}

// Slicer data and checks for the opened file. -1 = not in the file.
export struct FileInfo {
    path: string,
    minutes: int,
    filament: string,
    grams: int,
    layers: int,
    nozzle: float,
    // 1 same as the printer, 0 differs, -1 unknown.
    nozzle-check: int,
    thumb: image,
    has-thumb: bool,
}

component FileCard inherits Rectangle {
    in property <FileItem> item;
    in property <bool> select-mode;
    callback clicked;
    border-radius: Tokens.r-l;
    background: ta.pressed ? Tokens.surface-2 : Tokens.surface-1;
    border-width: root.select-mode && root.item.selected ? 3px : 0;
    border-color: Tokens.accent;
    accessible-role: button;
    accessible-label: root.item.name;
    accessible-checkable: root.select-mode;
    accessible-checked: root.item.selected;
    accessible-action-default => { root.clicked(); }
    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        Thumb {
            vertical-stretch: 1;
            border-radius: Tokens.r-s;
            source: root.item.thumb;
            has: root.item.has-thumb;
        }
        Text { text: root.item.name; color: Tokens.text; font-size: 15px; font-weight: 700; overflow: elide; }
        Text {
            text: Format.age(root.item.days-ago) + " · " + Format.size(root.item.size-kb);
            color: Tokens.text-dim;
            font-size: 13px;
            overflow: elide;
        }
    }
    if root.select-mode: Rectangle {
        x: parent.width - self.width - 14px;
        y: 14px;
        width: 30px;
        height: 30px;
        border-radius: 15px;
        background: root.item.selected ? Tokens.accent : #0b0d1099;
        border-width: 2px;
        border-color: root.item.selected ? Tokens.accent : Tokens.text-dim;
        if root.item.selected: Icon { d: "m5 12.5 4.5 4.5L19 7"; size: 18px; weight: 3; color: Tokens.accent-ink; }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

export component FilesScreen inherits VerticalLayout {
    horizontal-stretch: 1;
    in-out property <[FileItem]> files;
    in-out property <bool> select-mode;
    in-out property <int> selected-count;
    callback back;
    callback open(string);
    callback select-all(bool);
    callback ask-delete;
    padding: Tokens.pad;
    padding-bottom: 0;
    spacing: 12px;

    property <length> gap: 12px;
    property <length> card-height: 180px;
    property <int> rows: ceil(root.files.length / 3);

    if !root.select-mode: Header {
        title: @tr("Files");
        back-clicked => { root.back(); }
        IconButton {
            icon: "M3.5 3.5h17v17h-17z M8 12l3 3 5-6";
            label: @tr("Select several");
            visible: root.files.length > 0;
            clicked => { root.select-mode = true; }
        }
    }
    if root.select-mode: Header {
        title: root.selected-count > 0 ? @tr("Selected: {}", root.selected-count) : @tr("Pick files");
        back: false;
        IconButton {
            icon: "M6 6l12 12M18 6 6 18";
            label: @tr("Cancel selection");
            clicked => { root.select-mode = false; root.select-all(false); }
        }
        SecondaryButton {
            width: 160px;
            text: root.selected-count == root.files.length ? @tr("Clear all") : @tr("Select all");
            clicked => { root.select-all(root.selected-count != root.files.length); }
        }
    }

    if root.files.length == 0: VerticalLayout {
        vertical-stretch: 1;
        alignment: center;
        spacing: 8px;
        Text { text: @tr("No G-code files yet"); color: Tokens.text; font-size: Tokens.title; font-weight: 800; horizontal-alignment: center; }
        Text { text: @tr("Send a model from your slicer."); color: Tokens.text-dim; font-size: Tokens.body; horizontal-alignment: center; }
    }
    if root.files.length > 0: ScrollList {
        vertical-stretch: 1;
        Rectangle {
            height: root.rows * root.card-height + max(0, root.rows - 1) * root.gap;
            for item[i] in root.files: FileCard {
                property <length> w: (parent.width - 2 * root.gap) / 3;
                x: mod(i, 3) * (self.w + root.gap);
                y: floor(i / 3) * (root.card-height + root.gap);
                width: self.w;
                height: root.card-height;
                item: item;
                select-mode: root.select-mode;
                clicked => {
                    if (root.select-mode) {
                        // Count first: `item` follows the row once it changes.
                        root.selected-count += item.selected ? -1 : 1;
                        root.files[i].selected = !item.selected;
                    } else {
                        root.open(item.path);
                    }
                }
            }
        }
    }
    if root.select-mode: Rectangle {
        height: 76px;
        if root.selected-count > 0: DangerButton {
            text: @tr("Delete {}", root.selected-count);
            clicked => { root.ask-delete(); }
        }
        if root.selected-count == 0: Rectangle {
            border-radius: Tokens.r-m;
            background: Tokens.surface-2;
            Text { text: @tr("Delete"); color: Tokens.text-faint; font-size: Tokens.row-title; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
}

component CheckRow inherits Rectangle {
    in property <string> text;
    in property <bool> ok;
    height: 48px;
    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 13px;
                background: root.ok ? Tokens.accent-soft : #fbbf2426;
                if root.ok: Icon { d: "m5 12 5 5 9-10"; size: 14px; weight: 3; color: Tokens.accent; }
                if !root.ok: Text { text: "!"; color: Tokens.warn; font-size: 15px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        Text { text: root.text; color: Tokens.text; font-size: 15px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
    }
}

component Chip inherits Rectangle {
    in property <string> text;
    height: 36px;
    border-radius: 18px;
    background: Tokens.surface-1;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text { text: root.text; color: Tokens.text; font-size: 15px; font-weight: 600; vertical-alignment: center; }
    }
}

export component FileScreen inherits Rectangle {
    horizontal-stretch: 1;
    in property <string> path;
    in property <string> name;
    // May still be loading: shown only when it is about this file.
    in property <FileInfo> info;
    callback back;
    callback print-file;
    callback delete;
    property <bool> loaded: root.info.path == root.path;
    HorizontalLayout {
        padding: Tokens.pad;
        padding-right: 20px;
        spacing: 18px;
        VerticalLayout {
            width: 264px;
            spacing: 12px;
            HorizontalLayout { alignment: start; IconButton { icon: "m15 18-6-6 6-6"; label: @tr("Back to files"); clicked => { root.back(); } } }
            Thumb {
                width: 264px;
                height: 264px;
                border-radius: Tokens.r-l;
                icon-size: 120px;
                source: root.info.thumb;
                has: root.loaded && root.info.has-thumb;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 12px;
            Text { text: root.name; color: Tokens.text; font-size: Tokens.title; font-weight: 800; wrap: word-wrap; overflow: elide; }
            // Only what the slicer put in the file.
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                if root.loaded && root.info.minutes >= 0: Chip { text: Format.duration(root.info.minutes); }
                if root.loaded && (root.info.filament != "" || root.info.grams >= 0): Chip {
                    text: root.info.filament + (root.info.filament != "" && root.info.grams >= 0 ? " · " : "") + (root.info.grams >= 0 ? @tr("{} g", root.info.grams) : "");
                }
                if root.loaded && root.info.layers >= 0: Chip { text: @tr("{} layers", root.info.layers); }
            }
            if root.loaded && root.info.nozzle-check >= 0: Rectangle {
                border-radius: Tokens.r-m;
                background: Tokens.surface-1;
                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    CheckRow {
                        ok: root.info.nozzle-check == 1;
                        text: root.info.nozzle-check == 1 ? @tr("Nozzle {} mm: same as the printer", root.info.nozzle) : @tr("Sliced for a {} mm nozzle: not the printer's", root.info.nozzle);
                    }
                }
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 10px;
                Rectangle {
                    width: 80px;
                    height: 80px;
                    border-radius: Tokens.r-m;
                    background: del.pressed ? #fb4b5e40 : Tokens.danger-soft;
                    accessible-role: button;
                    accessible-label: @tr("Delete file");
                    accessible-action-default => { root.delete(); }
                    Icon { d: "M4 7h16 M9 7V4.5h6V7 M6.5 7l1 13h9l1-13 M10 11v5 M14 11v5"; size: 26px; color: Tokens.danger; }
                    del := TouchArea { clicked => { root.delete(); } }
                }
                PrimaryButton { text: @tr("Print"); min-height: 80px; clicked => { root.print-file(); } }
            }
        }
    }
}
