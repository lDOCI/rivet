export component ZOffsetScreen inherits VerticalLayout {
    horizontal-stretch: 1;
    in property <float> z-offset;
    in property <float> z-start;
    callback back;
    callback adjust-z(float);
    callback edit(string);
    padding: Tokens.pad;
    padding-bottom: 0;
    spacing: 10px;
    Header { title: @tr("Z-offset"); back-clicked => { root.back(); } }
    ScrollList {
        vertical-stretch: 1;
        FineStepper {
            title: @tr("Z-offset, mm");
            sub: @tr("applies at once");
            label: Format.signed(root.z-offset, 2);
            changed: round(root.z-offset * 100) != round(root.z-start * 100);
            was: Format.signed(root.z-start, 2);
            big: "0.05"; small: "0.01"; big-step: 0.05; small-step: 0.01;
            step(d) => { root.adjust-z(d); }
            edit => { root.edit("z"); }
        }
    }
}
