// The pictures the USB installer (tools/usb/flashforge_init.sh) puts on the
// screen while Rivet is not running yet. Rendered once by ui-snapshot into raw
// framebuffer images; never shown by the running app. English and Russian at
// once: nothing tells the installer the user's language.
import { Tokens } from "../kit/tokens.slint";
import { Icon } from "../kit/controls.slint";

export component InstallerScreen inherits Rectangle {
    // "installing" | "done" | "removed" | "error"
    in property <string> step: "installing";
    background: Tokens.bg;

    property <bool> bad: root.step == "error";
    property <bool> busy: root.step == "installing";

    VerticalLayout {
        padding-left: 64px;
        padding-right: 64px;
        alignment: center;
        HorizontalLayout {
            alignment: start;
            Rectangle {
                width: 84px;
                height: 84px;
                border-radius: 26px;
                background: root.bad ? #fb4b5e29 : Tokens.accent.with-alpha(0.16);
                Icon {
                    d: root.bad ? "M12 3.5 2.5 20h19z M12 9.5v5 M12 17.5v.5"
                        : root.busy ? "M12 4v11 M7 10l5 5 5-5 M5 20h14"
                        : "M5 12.5l4.5 4.5L19 7.5";
                    size: 42px;
                    weight: 2.2;
                    color: root.bad ? Tokens.danger : Tokens.accent;
                }
            }
        }
        Rectangle { height: 22px; }
        Text {
            text: root.step == "installing" ? "Installing Rivet…"
                : root.step == "done" ? "Rivet is installed"
                : root.step == "removed" ? "Rivet is removed"
                : "Rivet was not installed";
            color: Tokens.text;
            font-size: 34px;
            font-weight: 800;
            letter-spacing: -0.68px;
        }
        Text {
            text: root.step == "installing" ? "Устанавливаю Rivet…"
                : root.step == "done" ? "Rivet установлен"
                : root.step == "removed" ? "Rivet удалён"
                : "Rivet не установлен";
            color: Tokens.text-2;
            font-size: 26px;
            font-weight: 700;
        }
        Rectangle { height: 22px; }
        Text {
            text: root.busy ? "Do not turn the printer off. It takes about a minute."
                : root.bad ? "Nothing was changed. Why: rivet-install.log on the USB stick. Remove the stick and the printer restarts as before."
                : "Remove the USB stick: the printer restarts by itself.";
            color: Tokens.text-2;
            font-size: 18px;
            wrap: word-wrap;
        }
        Rectangle { height: 6px; }
        Text {
            text: root.busy ? "Не выключайте принтер. Это около минуты."
                : root.bad ? "Ничего не изменено. Причина — в rivet-install.log на флешке. Выньте флешку, и принтер перезагрузится как прежде."
                : "Выньте флешку — принтер перезагрузится сам.";
            color: Tokens.text-faint;
            font-size: 17px;
            wrap: word-wrap;
        }
    }
}
