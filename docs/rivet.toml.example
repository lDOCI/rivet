# Copy to /root/printer_data/config/rivet.toml (Klipper Mod; tools/install.sh does it) or next to the binary.
# Command line (--lang, --moonraker) and environment (RIVET_LANG, RIVET_MOONRAKER) win over this file.

# Interface language: "en" or "ru". Without it Rivet follows the system LANG, then English.
language = "ru"

# Moonraker websocket. The default is the printer itself.
# moonraker = "ws://127.0.0.1:7125/websocket"

# Log to a file (rotated: 512 KB, 3 old copies) instead of the terminal.
# log_file = "/root/printer_data/logs/rivet.log"   # /etc/init.d/S80rivet passes --log-file, which wins
# log_level = "info"   # error, warn, info, debug
